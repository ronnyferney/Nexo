# Variables para docker compose (genere secretos con: openssl rand -hex 32). Con NODE_ENV=production la API no
# arranca con valores de ejemplo, claves en ceros o de baja entropía.
JWT_SECRET=
ENCRYPTION_KEY=
# Obligatorias: contraseña de PostgreSQL (se fija al crear el volumen) y de Redis (requirepass). Use solo caracteres
# hexadecimales (openssl rand -hex 24): la de PostgreSQL va dentro de DATABASE_URL.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
ANTHROPIC_API_KEY=
# Nexo Copilot (ADR 0006): modelo de plataforma, cupo mensual por workspace (USD) y administradores de plataforma
COPILOT_PROVIDER=anthropic
COPILOT_MODEL=claude-opus-5-5
COPILOT_MONTHLY_QUOTA_USD=2
PLATFORM_ADMIN_EMAILS=
CORS_ORIGINS=http://localhost:8080
# Proxies de confianza para obtener la IP real del cliente (limitador de peticiones). Vacío = cualquier salto con IP
# privada o loopback (nginx de este compose; ALB → nginx en AWS). Si hay otro proxy con IP pública delante, indique el
# número exacto de saltos (p. ej. 2) o sus IP/CIDR. false = ignorar X-Forwarded-For.
TRUST_PROXY=
# Registro público: invite_only (por defecto en producción) u open. Correo saliente opcional para invitaciones y
# verificación (sin SMTP_URL la consola muestra el enlace de invitación).
REGISTRATION_MODE=
SMTP_URL=
MAIL_FROM=
# Swagger (/api/docs) en producción solo con true
SWAGGER_ENABLED=false
# Días que se conservan ejecuciones e historial de rutinas (por defecto 30)
EXECUTIONS_RETENTION_DAYS=30

# --- URLs públicas (OAuth2 de usuario y Nexo Edge, ADR 0005) ---
# Con docker compose la web (nginx) atiende en :8080 y reenvía /api a la API: ambas URLs son la misma.
PUBLIC_URL=http://localhost:8080
WEB_URL=http://localhost:8080
# Apps OAuth de la plataforma (opcional; los clientes también pueden usar su propia app)
OAUTH_HUBSPOT_CLIENT_ID=
OAUTH_HUBSPOT_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_SALESFORCE_CLIENT_ID=
OAUTH_SALESFORCE_CLIENT_SECRET=
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=
OAUTH_SLACK_CLIENT_ID=
OAUTH_SLACK_CLIENT_SECRET=
# Apps OAuth DE NEXO para iniciar sesión en proveedores IA (ADR 0002, D8). Registre la app de Nexo en cada proveedor
# con el redirect URI ${PUBLIC_URL}/api/llm/oauth/<proveedor>/callback. Nunca use el client_id de otro producto.
# Vacías = el mecanismo se muestra como no disponible (la clave de API sigue funcionando).
# Google Cloud (Vertex AI): app web, scope https://www.googleapis.com/auth/cloud-platform
OAUTH_LLM_VERTEX_CLIENT_ID=
OAUTH_LLM_VERTEX_CLIENT_SECRET=
# Microsoft Entra ID (Azure OpenAI): app web multiinquilino, scope https://cognitiveservices.azure.com/.default offline_access
OAUTH_LLM_AZURE_OPENAI_CLIENT_ID=
OAUTH_LLM_AZURE_OPENAI_CLIENT_SECRET=
# Hugging Face: app OAuth con scope inference-api (el secreto es opcional: app pública con PKCE)
OAUTH_LLM_HUGGINGFACE_CLIENT_ID=
OAUTH_LLM_HUGGINGFACE_CLIENT_SECRET=
# Usuario maestro del primer arranque (OWNER del workspace inicial). Contraseña de 12+ caracteres; cámbiela al entrar.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador de Nexo
BOOTSTRAP_WORKSPACE_NAME=Nexo

# --- Opcionales (valores por defecto) ---
# DEFAULT_MODEL=claude-opus-5-5
# JWT_EXPIRES_IN=12h
# SESSION_COOKIE_SECURE=true   # cookie de sesión de la web con Secure (por defecto en producción; exige HTTPS)
# LOG_LEVEL=info
# CONNECTOR_TIMEOUT_MS=30000
# CONNECTOR_ALLOW_PRIVATE_NETWORKS=false   # true solo en desarrollo: permite conectores hacia redes privadas
