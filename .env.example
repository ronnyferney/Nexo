# Variables para docker compose (genere secretos con: openssl rand -hex 32)
JWT_SECRET=
ENCRYPTION_KEY=
ANTHROPIC_API_KEY=
# Nexo Copilot (ADR 0006): modelo de plataforma, cupo mensual por workspace (USD) y administradores de plataforma
COPILOT_PROVIDER=anthropic
COPILOT_MODEL=claude-opus-5-5
COPILOT_MONTHLY_QUOTA_USD=2
PLATFORM_ADMIN_EMAILS=
POSTGRES_PASSWORD=nexo
CORS_ORIGINS=http://localhost:8080
# Días que se conservan ejecuciones e historial de rutinas (por defecto 30)
EXECUTIONS_RETENTION_DAYS=30

# --- URLs públicas (OAuth2 de usuario y Nexo Edge, ADR 0005) ---
PUBLIC_URL=http://localhost:3000
WEB_URL=http://localhost:4200
# Apps OAuth de la plataforma (opcional; los clientes también pueden usar su propia app)
OAUTH_HUBSPOT_CLIENT_ID=
OAUTH_HUBSPOT_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_SALESFORCE_CLIENT_ID=
OAUTH_SALESFORCE_CLIENT_SECRET=
