// Nexo — modelo de datos
// Multi-tenant por Workspace: todo recurso de negocio pertenece a un workspace.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum ConnectorType {
  REST
  SOAP
  GRAPHQL
  MCP
  DATABASE
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum LlmKind {
  ANTHROPIC
  OPENAI_COMPATIBLE
  MOCK
}

/// Cómo se autentica una conexión LLM: clave estática o token OAuth renovable (ADR 0002, D8).
enum LlmCredentialType {
  API_KEY
  OAUTH
}

/// Flujo de conexión de un proveedor LLM en curso (OAuth con redirección o código de dispositivo).
enum LlmAuthFlowType {
  OAUTH
  DEVICE_CODE
}

enum ModelTier {
  PREMIUM
  STANDARD
  ECONOMY
}

enum BudgetPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum BudgetPolicy {
  BLOCK
  DOWNGRADE
  ALERT_ONLY
}

enum UsageSource {
  CHAT
  WORKFLOW
  MCP
  ROUTINE
  EVAL
  COPILOT
}

enum AgentVisibility {
  PRIVATE
  TEAM
  WORKSPACE
}

enum SharePrincipal {
  USER
  UNIT
  /// Grupo de usuarios del workspace (p. ej. "Gerentes de línea"), ADR 0007 D6.
  GROUP
}

enum SharePermission {
  USE
  EDIT
}

/// Ciclo de vida del empleado digital (RF05/RF06). Ampliación aditiva y retrocompatible de DRAFT/LAUNCHED:
/// DRAFT=Borrador, EN_VALIDACION=En validación, LAUNCHED=Publicado, SUSPENDIDO=Suspendido, RETIRADO=Retirado.
/// Solo LAUNCHED publica por MCP y ejecuta rutinas (ADR 0006); el resto de estados no.
enum LaunchStatus {
  DRAFT
  EN_VALIDACION
  LAUNCHED
  SUSPENDIDO
  RETIRADO
}

/// Nivel jerárquico de un cargo (RF03, base de la jerarquía de dirección digital E3/RF32).
enum NivelJerarquico {
  EMPLEADO
  LIDER
  JEFE
  DIRECTOR
  GERENTE
  SUPEREMPLEADO
}

/// Tipo de nodo del árbol organizacional (ADR 0011 D2). Discriminador de la dimensión jerárquica/funcional. El valor
/// por defecto `AREA_FUNCIONAL` conserva la semántica de las unidades ya existentes (retrocompatibilidad).
enum OrgUnitTipo {
  GRUPO
  EMPRESA
  UNIDAD_NEGOCIO
  AREA_FUNCIONAL
  DEPARTAMENTO
  EQUIPO
}

/// Estado de vigencia de una pieza de estructura organizacional (ADR 0011 D2/D3/D4).
enum EstadoEstructura {
  ACTIVA
  SUSPENDIDA
  CERRADA
}

/// Tipo de relación matricial entre un sujeto (agente o miembro) y una dimensión destino (ADR 0011 D4). A lo sumo una
/// `FUNCIONAL_PRINCIPAL` vigente por sujeto (RF42): se garantiza con un índice parcial único creado por SQL manual.
enum TipoAsignacion {
  FUNCIONAL_PRINCIPAL
  LINEA
  SEDE
  PROYECTO
  SERVICIO
}

/// Política de DataGuard hacia los modelos de IA (ADR 0008 D2).
enum DataGuardMode {
  OFF
  MASK
  BLOCK
}

enum CopilotMode {
  CREATE
  IMPROVE
  DIAGNOSE
}

enum CopilotProposalKind {
  CREATE_AGENT
  UPDATE_AGENT
}

enum FeedbackRating {
  UP
  DOWN
}

enum ReviewStatus {
  PENDING
  APPROVED
  DISCARDED
}

enum EvalRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum SuggestionStatus {
  PENDING
  APPLIED
  REJECTED
}

enum KnowledgeSourceType {
  TEXT
  URL
  FILE
}

enum DocumentStatus {
  READY
  FAILED
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// Estado de una ejecución de agente registrada en `AgentRun` (instrumentación RX-14).
enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum TriggerType {
  MANUAL
  WEBHOOK
  SCHEDULE
  AGENT
  MCP
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  name                 String
  passwordHash         String
  /// Cuándo demostró controlar el correo (enlace de verificación o de invitación). Null = sin verificar: puede usar su
  /// propio workspace, pero no unirse a otros sin el token de una invitación ni ser administrador de la plataforma.
  emailVerifiedAt      DateTime?
  /// Versión de las sesiones: va en el JWT (`tv`); incrementarla invalida todos los tokens emitidos antes.
  tokenVersion         Int                  @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  memberships          Membership[]
  groupMemberships     UserGroupMember[]
  invitationsSent      Invitation[]         @relation("InvitationInviter")
  invitationsAccepted  Invitation[]         @relation("InvitationAcceptor")
  apiKeysCreated       ApiKey[]             @relation("ApiKeyCreator")
  passwordResets       PasswordResetToken[]
  responsibleForAgents Agent[]              @relation("AgentResponsible")
  substituteForAgents  Agent[]              @relation("AgentSubstitute")
}

/// Invitación a un workspace (C1): la membresía solo se crea cuando el dueño del correo acepta con el token de un solo
/// uso (se guarda su SHA-256). Una sola invitación activa por (workspace, correo): invitar de nuevo revoca la anterior.
model Invitation {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Correo normalizado (trim + minúsculas).
  email        String
  /// Nombre sugerido por quien invita (la persona puede cambiarlo al aceptar).
  name         String?
  role         Role
  orgUnitId    String?
  orgUnit      OrgUnit?  @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  tokenHash    String    @unique
  expiresAt    DateTime
  invitedById  String?
  invitedBy    User?     @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedAt   DateTime?
  acceptedById String?
  acceptedBy   User?     @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([workspaceId, email])
}

model Workspace {
  id                        String                     @id @default(cuid())
  name                      String
  slug                      String                     @unique
  /// Permite que cualquier miembro cree agentes personales (ADR 0007).
  allowPersonalAgents       Boolean                    @default(true)
  /// Política de DataGuard hacia los modelos de IA (ADR 0008 D2).
  dataGuardMode             DataGuardMode              @default(MASK)
  /// Días que se conservan conversaciones y mensajes (ADR 0008 D7; null = sin límite).
  conversationRetentionDays Int?
  /// Última vez que el workspace guardó sus ajustes de protección de datos (null = rige CONVERSATIONS_RETENTION_DAYS).
  privacySettingsUpdatedAt  DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  memberships               Membership[]
  connectors                Connector[]
  agents                    Agent[]
  userGroups                UserGroup[]
  workflows                 Workflow[]
  executions                Execution[]
  apiKeys                   ApiKey[]
  secrets                   Secret[]
  llmConnections            LlmConnection[]
  llmAuthFlows              LlmAuthFlow[]
  orgUnits                  OrgUnit[]
  usage                     UsageRecord[]
  agentRuns                 AgentRun[]
  skills                    Skill[]
  knowledgeBases            KnowledgeBase[]
  agentRoutines             AgentRoutine[]
  edgeAgents                EdgeAgent[]
  invitations               Invitation[]
  cargos                    Cargo[]
  lineasNegocio             LineaNegocio[]
  sedes                     Sede[]
  centrosCosto              CentroCosto[]
  asignaciones              AsignacionOrganizacional[]
  serviciosInternos         ServicioInterno[]
  imputacionesCosto         ImputacionCosto[]
  objetivos                 Objetivo[]
  tareas                    Tarea[]
  contratosResultado        ContratoResultado[]
  evidencias                Evidencia[]
  incumplimientos           Incumplimiento[]
  mensajesAgente            MensajeAgente[]
  transferencias            ContratoTransferencia[]
  canales                   Canal[]
  hilosCanal                HiloCanal[]
  politicas                 Politica[]
  decisionesPolitica        DecisionPolitica[]
  aprobaciones              Aprobacion[]
  suspensiones              Suspension[]
  dimensiones               Dimension[]
  dimensionValues           DimensionValue[]
  dimensionAssignments      DimensionAssignment[]
  idempotencyKeys           IdempotencyKey[]
  excepciones               Excepcion[]
}

/// Catálogo de cargos (RF03): perfil reutilizable del empleado digital con propósito, funciones, entregables,
/// indicadores, límites y nivel jerárquico. Un cargo describe la posición, no a la persona ni al agente concreto.
model Cargo {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nombre      String
  /// Propósito o misión del cargo.
  proposito   String?
  /// Funciones principales del cargo.
  funciones   String[]        @default([])
  /// Entregables o productos esperados.
  entregables String[]        @default([])
  /// Indicadores con los que se mide el desempeño del cargo.
  indicadores String[]        @default([])
  /// Límites: lo que el cargo NO debe hacer.
  limites     String[]        @default([])
  /// Nivel jerárquico (base de la jerarquía de dirección digital E3/RF32).
  nivel       NivelJerarquico @default(EMPLEADO)
  /// Un cargo inactivo deja de ofrecerse para asignar, sin romper los agentes que ya lo tienen.
  activo      Boolean         @default(true)
  agents      Agent[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([workspaceId])
}

model Membership {
  id          String    @id @default(cuid())
  role        Role      @default(EDITOR)
  userId      String
  workspaceId String
  /// Unidad corporativa a la que se imputa el consumo del usuario (null = raíz).
  orgUnitId   String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orgUnit     OrgUnit?  @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@unique([userId, workspaceId])
}

/// Llaves de API para integraciones máquina-a-máquina (webhooks, servidor MCP).
/// API key de integraciones (B3): alcance acotado, rol máximo y expiración. Solo se guarda el SHA-256.
model ApiKey {
  id            String    @id @default(cuid())
  name          String
  prefix        String
  hash          String    @unique
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Permisos (`read`, `write`, `agents:run`, `workflows:run`, `connectors:invoke`, `mcp`). `*` = alcance completo
  /// heredado de las claves anteriores a B3: la web sugiere rotarlas. Vacío = ninguna acción.
  scopes        String[]  @default([])
  /// Rol máximo efectivo de la clave; en uso se limita además al rol vigente de quien la creó.
  role          Role      @default(EDITOR)
  /// Null = sin expiración (solo un OWNER lo decide; las claves anteriores a B3 quedaron así).
  expiresAt     DateTime?
  revokedAt     DateTime?
  /// Motivo de la revocación (`manual`, `account_takeover`).
  revokedReason String?
  /// Quién la creó. Null en las claves anteriores a B3 (o si se eliminó la cuenta).
  createdById   String?
  createdBy     User?     @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([workspaceId])
  @@index([createdById])
}

/// Enlace de recuperación de contraseña (C1/B3): de un solo uso, 30 minutos; solo se guarda el SHA-256 del token.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Credenciales cifradas (AES-256-GCM). Nunca se devuelven en claro por la API.
model Secret {
  id          String    @id @default(cuid())
  name        String
  ciphertext  String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, name])
}

/// Sistema externo: API REST, servicio SOAP, endpoint GraphQL o servidor MCP.
model Connector {
  id             String               @id @default(cuid())
  name           String
  description    String?
  type           ConnectorType
  /// Configuración específica del tipo (baseUrl, wsdl, transporte MCP, headers...).
  config         Json                 @default("{}")
  /// Autenticación: { type: none|apiKey|bearer|basic|oauth2, ... } con referencias a secretos.
  auth           Json                 @default("{\"type\":\"none\"}")
  /// Integración del catálogo que originó el conector (ADR 0005), si aplica.
  catalogId      String?
  /// Secretos de la bóveda que el conector puede resolver (auditoría A4). Solo un ADMIN amplía la lista.
  allowedSecrets String[]             @default([])
  workspaceId    String
  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  operations     ConnectorOperation[]
  oauth          OAuthCredential?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([workspaceId])
}

/// Operación invocable de un conector. Cada operación se expone como "tool" para agentes.
model ConnectorOperation {
  id          String      @id @default(cuid())
  key         String
  name        String
  description String?
  /// JSON Schema de entrada.
  inputSchema Json        @default("{\"type\":\"object\",\"properties\":{}}")
  /// Definición: REST {method,path,query,headers,body}; SOAP {action,bodyTemplate}; GraphQL {query}; MCP {toolName}.
  definition  Json        @default("{}")
  connectorId String
  connector   Connector   @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  agentTools  AgentTool[]

  @@unique([connectorId, key])
}

model Agent {
  id                   String             @id @default(cuid())
  name                 String
  description          String?
  /// Nombre de un ícono del design system (p. ej. "inbox"); null = sin ícono (la web muestra "bot").
  icon                 String?
  provider             String             @default("anthropic")
  model                String             @default("claude-opus-5-5")
  systemPrompt         String             @default("")
  /// low | medium | high | xhigh | max
  effort               String             @default("medium")
  maxTurns             Int                @default(12)
  /// Perfil estructurado: { role, goals[], responsibilities[], boundaries[], tone, outputFormat, language } (ADR 0003).
  profile              Json               @default("{}")
  /// Cadena de respaldo "<providerId>:<modelId>" (máx. 3).
  fallbackModels       String[]           @default([])
  /// Política de enrutamiento multi-modelo (ADR 0010). null = comportamiento actual (principal + fallbackModels).
  routing              Json?
  /// Meta de calidad del bucle de mejora (0..1, ADR 0004).
  targetScore          Float              @default(0.85)
  /// Ciclo de vida de producción (ADR 0006): solo los agentes LAUNCHED se publican por MCP y ejecutan rutinas.
  launchStatus         LaunchStatus       @default(DRAFT)
  launchedAt           DateTime?
  launchOverrideReason String?
  /// Visibilidad y propiedad (ADR 0007).
  visibility           AgentVisibility    @default(PRIVATE)
  ownerId              String?
  shares               AgentShare[]
  /// Centro de costo cuando el agente corre sin usuario (flujos, webhooks, MCP).
  costCenterId         String?
  costCenter           OrgUnit?           @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  /// Expediente del empleado digital (RF02/RF04). Cargo que desempeña (perfil reutilizable), responsable humano
  /// titular y suplente. Un agente no puede publicarse sin responsable (RF06).
  cargoId              String?
  cargo                Cargo?             @relation(fields: [cargoId], references: [id], onDelete: SetNull)
  responsableUserId    String?
  responsableUser      User?              @relation("AgentResponsible", fields: [responsableUserId], references: [id], onDelete: SetNull)
  suplenteUserId       String?
  suplenteUser         User?              @relation("AgentSubstitute", fields: [suplenteUserId], references: [id], onDelete: SetNull)
  workspaceId          String
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tools                AgentTool[]
  conversations        Conversation[]
  skills               AgentSkill[]
  knowledge            AgentKnowledge[]
  examples             AgentExample[]
  routines             AgentRoutine[]
  feedback             MessageFeedback[]
  evalCases            EvalCase[]
  evalRuns             EvalRun[]
  versions             AgentVersion[]
  suggestions          PromptSuggestion[]
  runs                 AgentRun[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([workspaceId])
}

/// Registro persistente de cada ejecución de un agente (instrumentación defensiva, RX-14): da los KPIs reales
/// (tasa de éxito, duración, latencia al primer token) y la base del historial de tareas. Su escritura NUNCA
/// afecta ni bloquea la ejecución del agente: un fallo al registrar se loguea y se ignora.
model AgentRun {
  id             String         @id @default(cuid())
  workspaceId    String
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Usuario que originó la ejecución (null cuando corre sin usuario: flujos, webhooks, MCP).
  userId         String?
  source         UsageSource
  status         AgentRunStatus @default(RUNNING)
  error          String?
  model          String?
  providerId     String?
  startedAt      DateTime       @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  /// Tiempo hasta el primer token (primer evento de texto o tool del stream), en ms.
  ttftMs         Int?
  costUsd        Decimal?       @db.Decimal(18, 8)
  inputTokens    Int?
  outputTokens   Int?
  /// Datos enmascarados por DataGuard durante la ejecución (null si no se instrumenta).
  maskedCount    Int?
  conversationId String?
  executionId    String?
  createdAt      DateTime       @default(now())

  @@index([workspaceId, agentId, createdAt])
  @@index([workspaceId, createdAt])
}

model AgentTool {
  id               String             @id @default(cuid())
  agentId          String
  operationId      String
  /// Si es true, la llamada requiere aprobación humana (human-in-the-loop).
  requiresApproval Boolean            @default(false)
  agent            Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  operation        ConnectorOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([agentId, operationId])
}

model Conversation {
  id        String   @id @default(cuid())
  title     String   @default("Nueva conversación")
  /// Usuario dueño de la conversación (ADR 0007: las conversaciones son privadas).
  userId    String?
  /// Proveedor que produjo el historial (los formatos no son intercambiables).
  provider  String   @default("anthropic")
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Historial completo en formato del proveedor (append-only).
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId, userId])
  @@index([updatedAt])
}

/// Flujo de automatización como grafo dirigido (nodos + aristas).
model Workflow {
  id              String            @id @default(cuid())
  name            String
  description     String?
  active          Boolean           @default(false)
  /// { nodes: WorkflowNode[], edges: WorkflowEdge[] }
  definition      Json              @default("{\"nodes\":[],\"edges\":[]}")
  /// Cron para disparador programado (opcional).
  schedule        String?
  /// Token público para disparo vía webhook.
  webhookToken    String            @unique @default(cuid())
  version         Int               @default(1)
  /// Flujo que se dispara cuando una ejecución de este flujo falla (práctica n8n).
  errorWorkflowId String?
  workspaceId     String
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions      Execution[]
  versions        WorkflowVersion[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([workspaceId])
}

model Execution {
  id                String          @id @default(cuid())
  status            ExecutionStatus @default(QUEUED)
  trigger           TriggerType     @default(MANUAL)
  input             Json            @default("{}")
  output            Json?
  error             String?
  /// Bitácora por nodo: [{ nodeId, status, startedAt, finishedAt, input, output, error }]
  steps             Json            @default("[]")
  workflowId        String
  workflow          Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workspaceId       String
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Vínculo opcional y aditivo a la tarea cuyo trabajo ejecuta este flujo (E4/RF08). `null` = ejecución sin tarea
  /// (comportamiento previo intacto). Una tarea puede tener varias ejecuciones (segmentos del handoff llegan en E5).
  tareaId           String?
  tarea             Tarea?          @relation(fields: [tareaId], references: [id], onDelete: SetNull)
  /// Nº de segmento dentro de la tarea (handoff, E5/RF09). `null` = ejecución no segmentada (comportamiento previo).
  /// Único por `(tareaId, secuenciaSegmento)` a nivel de aplicación: reanudar un handoff no rehace un segmento.
  secuenciaSegmento Int?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime        @default(now())

  @@index([workspaceId, createdAt])
  @@index([workflowId])
  @@index([tareaId])
}

// ===================== Gobierno de IA (ADR 0002) =====================

/// Conexión a un proveedor LLM configurada por el administrador.
model LlmConnection {
  id                 String            @id @default(cuid())
  name               String
  kind               LlmKind
  baseUrl            String?
  /// API key cifrada con AES-256-GCM.
  apiKeyCipher       String?
  enabled            Boolean           @default(true)
  /// Id de la entrada del catálogo de proveedores (ADR 0002, D8). Null = conexión manual anterior al catálogo.
  providerId         String?
  /// Valores no secretos del formulario del catálogo (p. ej. recurso de Azure, región de Bedrock).
  providerFields     Json?
  /// Cabeceras HTTP adicionales no secretas que el driver envía en cada llamada.
  headers            Json?
  /// Opciones del driver: { authHeader: 'bearer' | 'api-key' | 'none', verifyPath, replayReasoning }.
  driverOptions      Json?
  /// API_KEY: `apiKeyCipher` es una clave estática. OAUTH: es el access token vigente y se renueva con el refresh token.
  credentialType     LlmCredentialType @default(API_KEY)
  /// Refresh token OAuth cifrado con AES-256-GCM (null si el proveedor no lo entrega).
  oauthRefreshCipher String?
  /// Expiración del access token OAuth (se renueva 60 s antes).
  oauthExpiresAt     DateTime?
  oauthScope         String?
  workspaceId        String
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  models             LlmModel[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, providerId])
}

/// Modelo habilitado en una conexión, con su tarifa (USD por millón de tokens).
model LlmModel {
  id                  String        @id @default(cuid())
  modelId             String
  label               String
  tier                ModelTier     @default(STANDARD)
  inputUsdPerMTok     Decimal       @db.Decimal(12, 6)
  outputUsdPerMTok    Decimal       @db.Decimal(12, 6)
  cacheReadUsdPerMTok Decimal?      @db.Decimal(12, 6)
  enabled             Boolean       @default(true)
  /// Importado sin tarifa verificada (precio 0): la consola pide completarla.
  needsPricing        Boolean       @default(false)
  /// Especialidades verificadas en la fuente oficial: CODE | REASONING | VISION | FAST | GENERAL.
  specialties         String[]      @default([])
  /// Ventana de contexto en tokens (null si no está verificada).
  contextTokens       Int?
  connectionId        String
  connection          LlmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([connectionId, modelId])
}

/// Flujo de conexión de un proveedor LLM en curso (ADR 0002, D8). Guarda en servidor lo que no debe viajar por el
/// navegador (device_code cifrado) y los datos del formulario hasta que el proveedor responde. Vida corta (≤ 15 min).
model LlmAuthFlow {
  id               String          @id @default(cuid())
  type             LlmAuthFlowType
  providerId       String
  userId           String
  /// Nombre de la conexión y valores no secretos del formulario (p. ej. proyecto y región de Vertex).
  name             String?
  fields           Json?
  models           String[]        @default([])
  /// device_code cifrado (solo DEVICE_CODE, mientras `status = pending`).
  deviceCodeCipher String?
  /// Tokens emitidos y cuenta autorizada, cifrados, mientras esperan la confirmación del ADMIN (`status = confirm`).
  pendingCipher    String?
  intervalSec      Int?
  nextPollAt       DateTime?
  /// pending | confirm | confirming | connected | expired | denied | cancelled
  status           String          @default("pending")
  connectionId     String?
  expiresAt        DateTime
  workspaceId      String
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())

  @@index([workspaceId])
  @@index([expiresAt])
}

/// Unidad corporativa (árbol). La raíz (parentId = null) es el tope global del workspace.
model OrgUnit {
  id                String           @id @default(cuid())
  name              String
  code              String?
  /// Modelos permitidos "<providerId>:<modelId>". Vacío = hereda del padre.
  allowedModels     String[]         @default([])
  parentId          String?
  parent            OrgUnit?         @relation("OrgTree", fields: [parentId], references: [id], onDelete: Restrict)
  children          OrgUnit[]        @relation("OrgTree")
  workspaceId       String
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Dimensión jerárquica/funcional (ADR 0011 D2). Las unidades previas migran a `AREA_FUNCIONAL` (default neutro).
  tipo              OrgUnitTipo      @default(AREA_FUNCIONAL)
  /// Empresa (OrgUnit `EMPRESA`) a la que pertenece la unidad. Desnormalizado para filtrar barato por empresa
  /// (ADR 0011 D1/D2). `null` en las unidades ya existentes (retrocompatible). Referencia blanda: se valida en servicio.
  empresaId         String?
  /// Responsable humano de la unidad (RF43). Referencia blanda a `User` (no concede acceso: ADR 0011 D6).
  responsableUserId String?
  /// Estado de vigencia de la unidad (ADR 0011 D2). Las unidades previas quedan `ACTIVA`.
  estado            EstadoEstructura @default(ACTIVA)
  /// Vigencia de la unidad (RF43). Opcionales; `null` = sin límite.
  vigenteDesde      DateTime?
  vigenteHasta      DateTime?
  memberships       Membership[]
  agents            Agent[]
  budget            Budget?
  ledger            BudgetLedger[]
  alerts            BudgetAlert[]
  usage             UsageRecord[]
  invitations       Invitation[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, tipo])
  @@index([workspaceId, empresaId])
}

/// Bolsa de presupuesto de una unidad (descuenta también el consumo de sus descendientes).
model Budget {
  id                  String       @id @default(cuid())
  orgUnitId           String       @unique
  orgUnit             OrgUnit      @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  period              BudgetPeriod @default(MONTHLY)
  limitUsd            Decimal      @db.Decimal(18, 8)
  policy              BudgetPolicy @default(BLOCK)
  alertThresholds     Int[]        @default([50, 80, 100])
  downgradeProviderId String?
  downgradeModel      String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

/// Gasto acumulado por unidad y periodo (incluye descendientes). Incrementos atómicos.
model BudgetLedger {
  orgUnitId String
  orgUnit   OrgUnit  @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  periodKey String
  spentUsd  Decimal  @default(0) @db.Decimal(18, 8)
  updatedAt DateTime @updatedAt

  @@id([orgUnitId, periodKey])
}

model BudgetAlert {
  id        String   @id @default(cuid())
  orgUnitId String
  orgUnit   OrgUnit  @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  periodKey String
  threshold Int
  spentUsd  Decimal  @db.Decimal(18, 8)
  limitUsd  Decimal  @db.Decimal(18, 8)
  createdAt DateTime @default(now())

  @@unique([orgUnitId, periodKey, threshold])
}

/// Registro de consumo por llamada al modelo. No guarda contenido de prompts ni respuestas.
model UsageRecord {
  id               String      @id @default(cuid())
  workspaceId      String
  workspace        Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orgUnitId        String?
  orgUnit          OrgUnit?    @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  userId           String?
  agentId          String?
  workflowId       String?
  executionId      String?
  conversationId   String?
  source           UsageSource
  providerId       String
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int         @default(0)
  cacheWriteTokens Int         @default(0)
  costUsd          Decimal     @db.Decimal(18, 8)
  /// Trazabilidad de enrutamiento (ADR 0010 D5): motivo de selección como código(s) auditable(s), nunca el
  /// razonamiento interno del modelo. Varios motivos se separan por coma. `null` = sin política de enrutamiento.
  routingReason    String?
  /// Rol del tramo en la orquestación (ADR 0010 D5): `draft`/`verify`/nombre de rol. `null` sin enrutamiento.
  role             String?
  /// Dimensiones de imputación integradas (ADR 0011 D5/RF45), capturadas como snapshot histórico en el momento de la
  /// ejecución (RF46/QA16). Son *etiquetas* del gasto ya medido: referencias blandas (IDs), validadas en servicio. NO
  /// cambian el cálculo del costo (ADR 0002 intacto) ni crean un segundo libro mayor. `areaEjecutoraId` suele coincidir
  /// con `orgUnitId` (el área que ejecuta); `empresaId` es la empresa ejecutora; `lineaBeneficiariaId`/`centroCostoId`/
  /// `sedeId` son dimensiones de reporte opcionales. Los registros previos quedan `null` (se imputan por `orgUnitId`).
  empresaId           String?
  areaEjecutoraId     String?
  lineaBeneficiariaId String?
  centroCostoId       String?
  sedeId              String?
  /// Snapshot histórico de las dimensiones configurables (ADR 0011 D8/RF46/QA16): mapa `{ dimensionCodigo: valor }`
  /// congelado al momento del hecho económico. Aditivo; los registros previos quedan `{}`. NO altera el cálculo del
  /// costo (ADR 0002 intacto): es solo una etiqueta analítica para pivotar en las consolas, no un libro mayor paralelo.
  dimensiones      Json        @default("{}")
  createdAt        DateTime    @default(now())

  @@index([workspaceId, createdAt])
  @@index([orgUnitId, createdAt])
  @@index([workspaceId, empresaId, createdAt])
  @@index([workspaceId, lineaBeneficiariaId, createdAt])
  @@index([workspaceId, centroCostoId, createdAt])
  @@index([workspaceId, areaEjecutoraId, createdAt])
}

// ===================== Estructura empresarial (ADR 0011 · E1) =====================
// Dimensiones ortogonales al árbol de mando (`OrgUnit`). No forman jerarquía ni conceden acceso por sí mismas
// (ADR 0011 D3/D6). Todo filtra por `workspaceId` (multi-tenant) y referencia su empresa (`OrgUnit` `EMPRESA`) por
// `empresaId`, validado en servicio. El marco de dimensiones configurables (D8) es una cédula aparte.

/// Línea de negocio (dimensión de negocio, ADR 0011 D3/RF41). Cruza áreas y empresas; no reemplaza el sistema de origen.
model LineaNegocio {
  id                String           @id @default(cuid())
  workspaceId       String
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// OrgUnit `EMPRESA` dueña de la línea (referencia blanda, validada en servicio).
  empresaId         String
  codigo            String
  nombre            String
  /// Responsable humano opcional (RF43). No concede acceso (ADR 0011 D6).
  responsableUserId String?
  /// Metas u objetivos comerciales opcionales (no reemplazan el sistema de origen, RF43).
  metas             Json             @default("{}")
  estado            EstadoEstructura @default(ACTIVA)
  vigenteDesde      DateTime?
  vigenteHasta      DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([workspaceId, empresaId, codigo])
  @@index([workspaceId, empresaId])
}

/// Sede (dimensión territorial, ADR 0011 D3/RF41). Es una etiqueta, no un sub-árbol; las áreas no se duplican por sede.
model Sede {
  id                 String           @id @default(cuid())
  workspaceId        String
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  empresaId          String
  codigo             String
  nombre             String
  /// Zona horaria IANA, p. ej. "America/Bogota".
  zonaHoraria        String
  /// Alcance territorial opcional (ciudades, regiones, países que cubre la sede).
  alcanceTerritorial String?
  estado             EstadoEstructura @default(ACTIVA)
  vigenteDesde       DateTime?
  vigenteHasta       DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([workspaceId, empresaId, codigo])
  @@index([workspaceId, empresaId])
}

/// Centro de costo (dimensión económica de reporte, ADR 0011 D3/RF45). Distinto del área; NO es la unidad de reserva
/// de presupuesto (esa sigue siendo `OrgUnit`/`Budget`, ADR 0002 intacto) y NO concede permisos (RF41/D6).
model CentroCosto {
  id             String           @id @default(cuid())
  workspaceId    String
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  empresaId      String
  codigo         String
  nombre         String
  /// Asociación por defecto opcional (referencias blandas; no conceden permisos).
  orgUnitId      String?
  lineaNegocioId String?
  estado         EstadoEstructura @default(ACTIVA)
  vigenteDesde   DateTime?
  vigenteHasta   DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([workspaceId, empresaId, codigo])
  @@index([workspaceId, empresaId])
}

/// Asignación organizacional (la matriz, ADR 0011 D4/RF42). Relaciona un sujeto (exactamente uno de `agentId`/`userId`,
/// validado en servicio) con una dimensión destino, con alcance y vigencia. Identificador estable que sobrevive a la
/// reorganización (QA16). No duplica agentes ni ejecuciones; NO concede acceso a datos por sí misma (D6). A lo sumo una
/// `FUNCIONAL_PRINCIPAL` vigente por sujeto (RF42): índice parcial único creado por SQL manual en la migración.
model AsignacionOrganizacional {
  id              String           @id @default(cuid())
  workspaceId     String
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Sujeto: exactamente uno de los dos (referencias blandas, validadas en servicio).
  agentId         String?
  userId          String?
  tipoAsignacion  TipoAsignacion
  /// Destino según `tipoAsignacion` (referencias blandas): área/equipo, línea, sede o proyecto (futuro).
  orgUnitId       String?
  lineaNegocioId  String?
  sedeId          String?
  proyectoId      String?
  /// Rol en esa dimensión (colaborador | revisor | responsable_proceso ...). Resuelve autoridad (RF33/RF42).
  rol             String?
  /// Qué habilita OPERATIVAMENTE la asignación (procesos/tareas). NUNCA acceso a datos (ADR 0011 D6).
  alcance         Json             @default("{}")
  estado          EstadoEstructura @default(ACTIVA)
  vigenteDesde    DateTime         @default(now())
  vigenteHasta    DateTime?
  creadaPorUserId String?
  createdAt       DateTime         @default(now())
  // Índice parcial único (SQL manual): a lo sumo una FUNCIONAL_PRINCIPAL vigente (vigenteHasta IS NULL) por sujeto.

  @@index([workspaceId, agentId])
  @@index([workspaceId, userId])
  @@index([workspaceId, lineaNegocioId])
}

// ===================== Costos e imputación / servicios compartidos (ADR 0011 · D5 / E9 · RF44/RF45) =====================
// Imputación de costos: las dimensiones del gasto viajan en `UsageRecord` (snapshot). Aquí viven los servicios
// compartidos y su reparto. El presupuesto y la reserva siguen en `OrgUnit`/`Budget` (ADR 0002 intacto): esto es reporte,
// NO un segundo libro mayor ni una segunda reserva. El reparto suma 100 % por (servicio, periodo) y no cuenta dos veces.

/// Servicio interno / compartido (RF44): proceso que un área (`areaDuenoId`) presta a otras líneas/áreas, con su
/// responsable y acuerdo de servicio. Su costo medido se reparte a los clientes internos con `ImputacionCosto`. No
/// concede acceso por sí mismo (ADR 0011 D6). Referencias blandas (empresa, área, responsables) validadas en servicio.
model ServicioInterno {
  id                 String            @id @default(cuid())
  workspaceId        String
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// OrgUnit EMPRESA dueña del servicio (aislamiento por empresa, ADR 0011 D1).
  empresaId          String
  /// OrgUnit que presta el servicio (área dueña, RF44).
  areaDuenoId        String
  codigo             String
  nombre             String
  /// Responsable humano/digital opcionales (no conceden acceso, D6).
  responsableUserId  String?
  responsableAgentId String?
  /// Acuerdo de servicio: entradas, salidas, criterios de calidad (texto/estructura libre).
  acuerdoServicio    Json              @default("{}")
  /// Clientes internos del servicio (líneas/áreas servidas): referencia descriptiva; el reparto efectivo va en
  /// `ImputacionCosto`. Estructura libre `[{ tipo, id, nombre }]`.
  clientesInternos   Json              @default("[]")
  estado             EstadoEstructura  @default(ACTIVA)
  vigenteDesde       DateTime?
  vigenteHasta       DateTime?
  imputaciones       ImputacionCosto[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([workspaceId, empresaId, codigo])
  @@index([workspaceId, empresaId])
  @@index([workspaceId, areaDuenoId])
}

/// Reparto del costo de un servicio compartido (RF45): una fila por destino con un porcentaje. La suma por
/// (servicioInterno, periodoKey) = 100 % (invariante pura validada al guardar y en la consolidación). El destino es
/// exactamente uno de línea/área/centro de costo. Es reparto de reporte: NO toca `BudgetLedger` (sin doble reserva) y
/// un mismo gasto no se cuenta dos veces (el total imputado = total medido del servicio).
model ImputacionCosto {
  id                String          @id @default(cuid())
  workspaceId       String
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  servicioInternoId String
  servicioInterno   ServicioInterno @relation(fields: [servicioInternoId], references: [id], onDelete: Cascade)
  /// Clave de periodo coherente con `BudgetLedger.periodKey` (p. ej. "2026-M10").
  periodoKey        String
  /// Destino: exactamente uno (validado en servicio y en reglas puras). Referencias blandas.
  lineaNegocioId    String?
  orgUnitId         String?
  centroCostoId     String?
  porcentaje        Decimal         @db.Decimal(5, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([workspaceId, servicioInternoId, periodoKey])
}

// ===================== Marco de dimensiones configurables (ADR 0011 · D8, estilo NetSuite / SAP CO-PA) =====================
// Etiquetado analítico ortogonal a todo lo anterior: el cliente define sus dimensiones y valores SIN tocar el esquema y
// cualquier ejecución/tarea/costo se etiqueta con ellas para reportar y consolidar por cualquier combinación (pivot).
// Las tres dimensiones de negocio (D3) se exponen también como `Dimension` de sistema (`esSistema=true`,
// `tipoValor=REFERENCIA`) que apuntan a `LineaNegocio`/`Sede`/`CentroCosto` SIN duplicar datos. Etiquetar NO concede
// acceso (D6/RF46). El permiso efectivo sigue siendo rol + share + empresa.

/// Tipo de valor de una dimensión (ADR 0011 D8). `LISTA` = valores propios (`DimensionValue`); `REFERENCIA` = apunta a
/// una entidad existente (LineaNegocio/Sede/OrgUnit...); `TEXTO`/`NUMERO` = valor literal en el etiquetado.
enum DimensionTipoValor {
  LISTA
  REFERENCIA
  TEXTO
  NUMERO
}

/// Definición de una dimensión analítica (ADR 0011 D8). Metadato de configuración, versionado por vigencia. El cliente
/// crea las suyas (Proyecto, Cliente, Producto, Campaña) sin migración; las 3 integradas se siembran con `esSistema`.
model Dimension {
  id                             String             @id @default(cuid())
  workspaceId                    String
  workspace                      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// `null` = aplica a toda la organización (grupo); si no, a una empresa (OrgUnit EMPRESA). Validado en servicio.
  empresaId                      String?
  codigo                         String
  nombre                         String
  tipoValor                      DimensionTipoValor @default(LISTA)
  /// Si `tipoValor = REFERENCIA`: entidad apuntada ("LineaNegocio" | "Sede" | "CentroCosto" | "OrgUnit" ...).
  referenciaEntidad              String?
  /// Si sus valores forman árbol (roll-up tipo NetSuite). Sin ciclos en `DimensionValue.padreId` (validado en servicio).
  jerarquica                     Boolean            @default(false)
  obligatoria                    Boolean            @default(false)
  /// Se valida al despachar/registrar trabajo con efecto económico (RF11/RF45): sin su valor, no se etiqueta.
  obligatoriaParaEfectoEconomico Boolean            @default(false)
  /// Entidades/acciones etiquetables ("ejecucion" | "tarea" | "costo" | "agente" | "unidad" | "linea" | "servicio"...).
  aplicaA                        String[]           @default([])
  /// Las 3 integradas de D3 (línea de negocio, sede, centro de costo). No se editan ni borran por el cliente.
  esSistema                      Boolean            @default(false)
  estado                         EstadoEstructura   @default(ACTIVA)
  vigenteDesde                   DateTime?
  vigenteHasta                   DateTime?
  valores                        DimensionValue[]
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @updatedAt

  // Unicidad de `codigo` por (workspaceId, empresaId) (D8). Para empresas concretas la cubre este índice; para las
  // dimensiones de organización (empresaId IS NULL, donde Postgres trata los NULL como distintos) la unicidad la
  // garantiza un índice parcial único creado por SQL manual en la migración ("Dimension_codigo_org_wide").
  @@unique([workspaceId, empresaId, codigo])
  @@index([workspaceId, empresaId])
}

/// Valor de una dimensión `LISTA` (ADR 0011 D8), jerárquico opcional (`padreId`). Un valor no ACTIVO o fuera de vigencia
/// NO es asignable a trabajo nuevo pero se conserva para el histórico y los reportes del periodo en que estuvo vigente.
model DimensionValue {
  id           String           @id @default(cuid())
  workspaceId  String
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dimensionId  String
  dimension    Dimension        @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  codigo       String
  nombre       String
  padreId      String?
  padre        DimensionValue?  @relation("DimensionValueTree", fields: [padreId], references: [id], onDelete: SetNull)
  hijos        DimensionValue[] @relation("DimensionValueTree")
  estado       EstadoEstructura @default(ACTIVA)
  vigenteDesde DateTime?
  vigenteHasta DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([dimensionId, codigo])
  @@index([workspaceId, dimensionId])
}

/// Etiquetado (ADR 0011 D8): vincula una entidad etiquetable (`targetType` + `targetId`) con una dimensión y su valor
/// (`dimensionValueId` para LISTA/REFERENCIA, o `valorLiteral` para TEXTO/NUMERO). Una misma ejecución lleva N
/// dimensiones. Filtra por `workspaceId`. NO concede acceso (D6). Referencias blandas validadas en servicio.
model DimensionAssignment {
  id               String    @id @default(cuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dimensionId      String
  dimensionValueId String?
  valorLiteral     String?
  targetType       String
  targetId         String
  createdAt        DateTime  @default(now())

  @@unique([workspaceId, dimensionId, targetType, targetId])
  @@index([workspaceId, targetType, targetId])
  @@index([workspaceId, dimensionId, dimensionValueId])
}

// ===================== Estudio de agentes y n8n (ADR 0003) =====================

/// Habilidad reutilizable: instrucciones + operaciones, cargada bajo demanda por el agente (load_skill).
model Skill {
  id           String       @id @default(cuid())
  name         String
  slug         String
  description  String
  instructions String
  /// Operaciones de conector que la skill aporta como herramientas.
  operationIds String[]     @default([])
  workspaceId  String
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agents       AgentSkill[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([workspaceId, slug])
}

model AgentSkill {
  agentId String
  skillId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([agentId, skillId])
}

model KnowledgeBase {
  id          String              @id @default(cuid())
  name        String
  description String?
  workspaceId String
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents   KnowledgeDocument[]
  chunks      KnowledgeChunk[]
  agents      AgentKnowledge[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([workspaceId])
}

model AgentKnowledge {
  agentId         String
  knowledgeBaseId String
  // Si es true, el agente puede escribir (aprender) en esta base con la herramienta interna `save_knowledge`.
  canWrite        Boolean       @default(false)
  agent           Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@id([agentId, knowledgeBaseId])
}

model KnowledgeDocument {
  id              String              @id @default(cuid())
  title           String
  sourceType      KnowledgeSourceType
  source          String?
  status          DocumentStatus      @default(READY)
  error           String?
  charCount       Int                 @default(0)
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase       @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks          KnowledgeChunk[]
  createdAt       DateTime            @default(now())

  @@index([knowledgeBaseId])
}

/// Fragmento indexado con búsqueda full-text de PostgreSQL (columna tsvector generada en la migración).
model KnowledgeChunk {
  id              String                   @id @default(cuid())
  ordinal         Int
  content         String
  search          Unsupported("tsvector")?
  documentId      String
  document        KnowledgeDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase            @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId])
}

/// Ejemplo de entrenamiento few-shot (entrada → salida esperada).
model AgentExample {
  id        String   @id @default(cuid())
  input     String
  output    String
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// Tarea recurrente de un agente (cron + instrucción).
model AgentRoutine {
  id               String       @id @default(cuid())
  name             String
  prompt           String
  schedule         String
  timezone         String       @default("UTC")
  enabled          Boolean      @default(true)
  notifyWebhookUrl String?
  lastRunAt        DateTime?
  lastStatus       RunStatus?
  agentId          String
  agent            Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId      String
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs             RoutineRun[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([workspaceId])
}

model RoutineRun {
  id         String       @id @default(cuid())
  status     RunStatus    @default(RUNNING)
  output     String?
  error      String?
  costUsd    Decimal      @default(0) @db.Decimal(18, 8)
  routineId  String
  routine    AgentRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  startedAt  DateTime     @default(now())
  finishedAt DateTime?

  @@index([routineId, startedAt])
}

/// Versión anterior de la definición de un flujo (historial inmutable).
model WorkflowVersion {
  id         String   @id @default(cuid())
  version    Int
  definition Json
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([workflowId, version])
}

// ===================== Bucle de mejora supervisada (ADR 0004) =====================

/// Calificación y corrección humana de una respuesta del agente.
model MessageFeedback {
  id             String         @id @default(cuid())
  agentId        String
  agent          Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId    String
  conversationId String?
  userId         String?
  userMessage    String
  agentResponse  String
  rating         FeedbackRating
  comment        String?
  correction     String?
  status         ReviewStatus   @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@index([workspaceId, status, createdAt])
  @@index([agentId, createdAt])
}

/// Caso de prueba del agente (entrada, respuesta de referencia y rúbrica).
model EvalCase {
  id        String       @id @default(cuid())
  agentId   String
  agent     Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  input     String
  expected  String?
  criteria  String?
  tags      String[]     @default([])
  results   EvalResult[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([agentId])
}

model EvalRun {
  id              String             @id @default(cuid())
  agentId         String
  agent           Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId     String
  versionId       String?
  version         AgentVersion?      @relation(fields: [versionId], references: [id], onDelete: SetNull)
  status          EvalRunStatus      @default(QUEUED)
  judgeProviderId String
  judgeModel      String
  passThreshold   Float              @default(0.7)
  score           Float?
  passed          Int                @default(0)
  total           Int                @default(0)
  costUsd         Decimal            @default(0) @db.Decimal(18, 8)
  error           String?
  results         EvalResult[]
  suggestions     PromptSuggestion[]
  createdAt       DateTime           @default(now())
  finishedAt      DateTime?

  @@index([agentId, createdAt])
}

model EvalResult {
  id          String    @id @default(cuid())
  runId       String
  run         EvalRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  caseId      String?
  case        EvalCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  input       String
  expected    String?
  output      String?
  score       Float?
  passed      Boolean   @default(false)
  reasoning   String?
  needsReview Boolean   @default(false)
  humanScore  Float?
  humanNote   String?
  createdAt   DateTime  @default(now())

  @@index([runId])
}

/// Instantánea inmutable de la configuración de un agente.
model AgentVersion {
  id          String    @id @default(cuid())
  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json
  note        String?
  createdById String?
  evalRuns    EvalRun[]
  createdAt   DateTime  @default(now())

  @@unique([agentId, version])
}

/// Propuesta de mejora del prompt generada por IA; requiere aprobación humana.
model PromptSuggestion {
  id          String           @id @default(cuid())
  agentId     String
  agent       Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runId       String?
  run         EvalRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  status      SuggestionStatus @default(PENDING)
  rationale   String
  proposal    Json
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime         @default(now())

  @@index([agentId, createdAt])
}

// ===================== Catálogo, OAuth2 y Nexo Edge (ADR 0005) =====================

/// Tokens OAuth2 (authorization code) de un conector, cifrados con AES-256-GCM.
/// App OAuth de la plataforma por proveedor («Iniciar sesión con…» de las apps conectadas). La configura un
/// administrador de la plataforma desde la consola; el secreto va cifrado (contexto platform-oauth-app.client-secret).
/// Las variables OAUTH_<PROVEEDOR>_CLIENT_ID/SECRET quedan como respaldo si no hay fila.
model PlatformOAuthApp {
  provider           String   @id
  clientId           String
  clientSecretCipher String
  updatedById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model OAuthCredential {
  id                 String    @id @default(cuid())
  connectorId        String    @unique
  connector          Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  accessTokenCipher  String
  refreshTokenCipher String?
  expiresAt          DateTime?
  scope              String?
  accountLabel       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// Agente on-premise que conecta Nexo con bases de datos en redes privadas (conexión saliente WSS).
model EdgeAgent {
  id          String    @id @default(cuid())
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  lastSeenAt  DateTime?
  version     String?
  hostname    String?
  /// Claves de conexión que el Edge declara disponibles (sin credenciales).
  connections String[]  @default([])
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

// ===================== Nexo Copilot (ADR 0006) =====================

/// Conversación con el Copilot (agente propiedad de Nexo). El historial nativo del proveedor vive en `history`.
model CopilotSession {
  id          String            @id @default(cuid())
  workspaceId String
  userId      String
  agentId     String?
  mode        CopilotMode
  context     String?
  providerId  String
  model       String
  history     Json              @default("[]")
  messages    CopilotMessage[]
  proposals   CopilotProposal[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([workspaceId, createdAt])
  @@index([workspaceId, updatedAt])
}

/// Mensaje visible de la conversación (texto plano), calificable por el usuario.
model CopilotMessage {
  id        String           @id @default(cuid())
  sessionId String
  session   CopilotSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  text      String
  feedback  CopilotFeedback?
  createdAt DateTime         @default(now())

  @@index([sessionId, createdAt])
}

model CopilotProposal {
  id          String              @id @default(cuid())
  sessionId   String
  session     CopilotSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workspaceId String
  agentId     String?
  kind        CopilotProposalKind
  status      SuggestionStatus    @default(PENDING)
  summary     String
  payload     Json
  appliedById String?
  appliedAt   DateTime?
  createdAt   DateTime            @default(now())

  @@index([workspaceId, createdAt])
}

/// Calificación del usuario a una respuesta del Copilot (calidad gestionada por Nexo).
model CopilotFeedback {
  id                 String         @id @default(cuid())
  messageId          String         @unique
  message            CopilotMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  workspaceId        String
  userId             String
  rating             FeedbackRating
  comment            String?
  /// Solo si el usuario decidió compartir la conversación con Nexo.
  sharedConversation Json?
  createdAt          DateTime       @default(now())

  @@index([createdAt])
}

// ===================== Visibilidad y permisos de agentes (ADR 0007) =====================

model AgentShare {
  id            String          @id @default(cuid())
  agentId       String
  agent         Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  principalType SharePrincipal
  principalId   String
  permission    SharePermission @default(USE)
  createdAt     DateTime        @default(now())

  @@unique([agentId, principalType, principalId])
  @@index([principalType, principalId])
}

/// Grupo de usuarios transversal a las unidades (p. ej. "Gerentes de línea") al que se publican agentes (ADR 0007 D6).
model UserGroup {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     UserGroupMember[]

  @@unique([workspaceId, name])
}

model UserGroupMember {
  groupId   String
  group     UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

// ===================== Trabajo por resultados (ADR 0012 · E4) =====================
// Núcleo de la gestión obligatoria por resultados (RF07, RF08, RF29, RF30, RF31). Entidades aditivas y multi-tenant:
// toda consulta filtra por `workspaceId` (de `@CurrentAuth()`). Las referencias a `User`/`Agent`/`OrgUnit` son blandas
// (se validan en servicio y NO conceden acceso, igual que la estructura empresarial E1). La comunicación entre agentes,
// el handoff y los canales (E5: MensajeAgente, ContratoTransferencia, Canal, HiloCanal) son una cédula aparte.

/// Estado OPERATIVO de la tarea (ciclo del trabajo como DAG). Ortogonal al estado del resultado (RF08, solicitud §4).
enum EstadoTarea {
  PENDIENTE
  EN_EJECUCION
  ESPERANDO_APROBACION
  BLOQUEADA
  EN_REVISION
  COMPLETADA
  FALLIDA_CANCELADA
}

/// Estado del RESULTADO (verificable, RF29/RF31). COMPLETADA como DAG no implica ACEPTADO como resultado.
enum EstadoResultado {
  PROPUESTO
  COMPROMETIDO
  EN_PRODUCCION
  PENDIENTE_VALIDACION
  ACEPTADO
  DEVUELTO_INCUMPLIDO
}

/// Un producto intermedio (un correo redactado) no satisface un resultado de negocio (un recaudo confirmado), RF29.
enum TipoResultado {
  PRODUCTO_INTERMEDIO
  RESULTADO_NEGOCIO
}

/// Modo de verificación del resultado (RF30/ADR 0010 D4). ASISTIDA reutiliza la verificación cruzada, no la reimplementa.
enum ModoValidacion {
  DETERMINISTA
  HUMANA
  ASISTIDA
}

enum VeredictoValidacion {
  ACEPTA
  DEVUELVE
}

/// Tipo de mensaje del protocolo entre agentes (RF35). HANDOFF acompaña un `ContratoTransferencia` (continuidad, RF09).
enum TipoMensaje {
  ASIGNACION
  ACEPTACION
  SOLICITUD_INFO
  ENTREGA
  DEVOLUCION
  BLOQUEO
  ESCALAMIENTO
  CIERRE
  HANDOFF
}

/// Estado de un contrato de transferencia (handoff). El receptor ACEPTA (encola el segmento) o RECHAZA (devuelve).
enum EstadoTransferencia {
  PROPUESTO
  ACEPTADO
  RECHAZADO
}

/// Ámbito de un canal de coordinación transversal (RF36).
enum TipoCanal {
  MISION
  PROCESO
  AREA
}

/// Objetivo (RF07): indicador, línea base, meta y plazo con dueño humano y responsable digital. Agrupa tareas.
/// Lo autoriza un humano (el sistema solo propone). Vínculo opcional a una unidad/empresa/línea por `orgUnitId`.
model Objetivo {
  id                 String    @id @default(cuid())
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Empresa / área / línea de negocio a la que pertenece (referencia blanda, validada en servicio).
  orgUnitId          String?
  codigo             String
  nombre             String
  indicador          String?
  lineaBase          String?
  meta               String?
  /// Fecha de negocio comprometida.
  plazo              DateTime?
  /// Dueño humano (referencia blanda a `User`; no concede acceso).
  duenoUserId        String?
  /// Responsable digital (referencia blanda a `Agent`).
  responsableAgentId String?
  /// Vigencia e historia (QA16): una reorganización no altera objetivos pasados.
  validFrom          DateTime  @default(now())
  validTo            DateTime?
  tareas             Tarea[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([workspaceId, codigo])
  @@index([workspaceId, orgUnitId])
}

/// Tarea (RF08): unidad de trabajo con criterio de aceptación, responsable (agente/equipo), dueño humano, prioridad,
/// fecha límite y estado operativo. Distingue producto intermedio de resultado de negocio. Lleva campos de delegación
/// (cadena `parentTareaId`, `profundidadDelegacion`, `correlationId`) para el control de ciclos de E5 (RF10).
model Tarea {
  id                    String                  @id @default(cuid())
  workspaceId           String
  workspace             Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orgUnitId             String?
  objetivoId            String?
  objetivo              Objetivo?               @relation(fields: [objetivoId], references: [id], onDelete: SetNull)
  titulo                String
  descripcion           String?
  criterioAceptacion    String?
  entradas              Json                    @default("{}")
  /// Responsable digital ejecutor (referencia blanda a `Agent`). El verificador debe ser distinto (RF30).
  responsableAgentId    String?
  equipoId              String?
  /// Dueño humano (referencia blanda a `User`).
  duenoUserId           String?
  prioridad             Int                     @default(3)
  fechaLimite           DateTime?
  estado                EstadoTarea             @default(PENDIENTE)
  tipoResultado         TipoResultado           @default(PRODUCTO_INTERMEDIO)
  /// Delegación y control de ciclos (RF10; la validación dura llega con el handoff de E5).
  parentTareaId         String?
  profundidadDelegacion Int                     @default(0)
  correlationId         String?
  validFrom             DateTime                @default(now())
  validTo               DateTime?
  contratoResultado     ContratoResultado?
  executions            Execution[]
  evidencias            Evidencia[]
  incumplimientos       Incumplimiento[]
  mensajes              MensajeAgente[]
  transferencias        ContratoTransferencia[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([workspaceId, estado])
  @@index([workspaceId, objetivoId])
  @@index([workspaceId, fechaLimite])
  @@index([parentTareaId])
}

/// Contrato de resultado (RF29): el resultado esperado como objeto verificable. Una descripción libre no lo reemplaza.
/// Un contrato COMPROMETIDO es inmutable: un cambio crea una versión nueva. La `reglaValidacion` es declarativa
/// (se evalúa con el motor de reglas puro del flujo, NUNCA con `eval`/`new Function`).
model ContratoResultado {
  id                 String                @id @default(cuid())
  workspaceId        String
  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tareaId            String?               @unique
  tarea              Tarea?                @relation(fields: [tareaId], references: [id], onDelete: SetNull)
  resultadoEsperado  String
  alcance            String?
  entradas           Json                  @default("{}")
  responsableAgentId String?
  duenoUserId        String?
  fecha              DateTime?
  presupuestoUsd     Decimal?              @db.Decimal(18, 8)
  indicador          String?
  /// Regla determinista declarativa: { combinator?: 'and'|'or', rules: [{ left, operator, right }] } (motor de flujos).
  reglaValidacion    Json                  @default("{}")
  /// Tipos/fuentes de evidencia obligatorios para aceptar.
  evidenciaExigida   Json                  @default("[]")
  tipoResultado      TipoResultado         @default(RESULTADO_NEGOCIO)
  nivelRiesgo        Int                   @default(1)
  estado             EstadoResultado       @default(PROPUESTO)
  version            Int                   @default(1)
  /// Tras comprometer queda inmutable (nueva versión para cambios).
  comprometidoAt     DateTime?
  validaciones       ValidacionResultado[]
  evidencias         Evidencia[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([workspaceId, estado])
}

/// Validación del resultado (RF30). Invariante de aplicación (garantizado en servicio): el verificador es distinto
/// del ejecutor. Una devolución conserva versión y motivo (código auditable, nunca el razonamiento del modelo).
model ValidacionResultado {
  id                  String              @id @default(cuid())
  workspaceId         String
  contratoResultadoId String
  contrato            ContratoResultado   @relation(fields: [contratoResultadoId], references: [id], onDelete: Cascade)
  modo                ModoValidacion
  /// Verificador: distinto del ejecutor (`Tarea.responsableAgentId`) y, si es humano, del dueño ejecutor.
  verificadorAgentId  String?
  validadorUserId     String?
  reglaAplicada       Json?
  veredicto           VeredictoValidacion
  motivo              String?
  evidenciaIds        String[]            @default([])
  /// Versión del contrato evaluada (la devolución conserva versión y motivo).
  version             Int                 @default(1)
  createdAt           DateTime            @default(now())

  @@index([workspaceId, contratoResultadoId])
}

/// Evidencia (prueba del resultado): REFERENCIA autorizada a la fuente (id externo, ejecución, enlace), no copia de
/// datos sensibles (RF35). Lleva propietario y vigencia. Puede colgar de la tarea o del contrato.
model Evidencia {
  id                  String             @id @default(cuid())
  workspaceId         String
  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contratoResultadoId String?
  contrato            ContratoResultado? @relation(fields: [contratoResultadoId], references: [id], onDelete: SetNull)
  tareaId             String?
  tarea               Tarea?             @relation(fields: [tareaId], references: [id], onDelete: SetNull)
  tipo                String
  descripcion         String?
  /// Referencia autorizada a la fuente: { connectorOpId?, externalId?, executionId?, url? }.
  referencia          Json               @default("{}")
  hash                String?
  /// Propietario de la evidencia (referencia blanda a `User`).
  propietarioUserId   String?
  /// Vigencia de la evidencia (null = sin límite).
  vigenteHasta        DateTime?
  createdAt           DateTime           @default(now())

  @@index([workspaceId, contratoResultadoId])
  @@index([workspaceId, tareaId])
}

/// Incumplimiento + plan de recuperación (RF31): alerta, responsable, plazo, y LÍMITES explícitos de reintentos,
/// gasto y ciclos, con escalamiento al siguiente nivel digital. Al agotar el límite se declara (nunca queda activo
/// indefinidamente ocultando un resultado no logrado). Lo detecta el cron de reconciliación existente.
model Incumplimiento {
  id                String    @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tareaId           String
  tarea             Tarea     @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  causa             String
  /// Responsable humano del plan (referencia blanda a `User`).
  responsableUserId String?
  /// Escalamiento al siguiente nivel digital (referencia blanda a `Agent`).
  escalaAgentId     String?
  planRecuperacion  String?
  plazo             DateTime?
  maxReintentos     Int       @default(0)
  maxCostoUsd       Decimal?  @db.Decimal(18, 8)
  maxCiclos         Int       @default(0)
  intentos          Int       @default(0)
  ciclos            Int       @default(0)
  /// `true` cuando el plan se resolvió (recuperado) o se declaró agotado el límite: el proceso deja de estar activo.
  resuelto          Boolean   @default(false)
  /// Cómo se cerró: null (abierto), `RECUPERADO`, `LIMITE_AGOTADO`, `PLAZO_VENCIDO`.
  resolucion        String?
  resueltoAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId, tareaId])
  @@index([workspaceId, resuelto])
}

/// Protocolo estructurado y persistente entre agentes (RF35). La "conversación" es una proyección de estos registros,
/// no una fuente de verdad paralela. `messageId` es la clave de idempotencia provista por el emisor:
/// `@@unique([workspaceId, messageId])` garantiza que una redelivery NO crea otra tarea ni otro efecto (QA11).
/// Los hechos de ciclo de vida (enviado/recibido/aceptado/resuelto) son registros distintos (timestamps). Un mensaje
/// NO autoriza efectos ni amplía atribuciones: `permisos` es el alcance que acompaña, nunca lo expande (RF09/QA02).
model MensajeAgente {
  id                   String      @id @default(cuid())
  workspaceId          String
  workspace            Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Empresa a la que pertenece el mensaje (referencia blanda a `OrgUnit` tipo EMPRESA); no concede acceso.
  empresaId            String?
  /// Clave de idempotencia del emisor (RF35/QA11). Única por workspace.
  messageId            String
  /// Hilo de negocio (correlación) que agrupa el intercambio.
  correlationId        String?
  emisorAgentId        String?
  destinatarioAgentId  String?
  /// Destinatario de grupo (equipo) como referencia blanda.
  destinatarioEquipoId String?
  canalId              String?
  /// Objetivo (misión) asociado.
  misionId             String?
  tareaId              String?
  tarea                Tarea?      @relation(fields: [tareaId], references: [id], onDelete: SetNull)
  tipo                 TipoMensaje
  prioridad            Int         @default(3)
  version              Int         @default(1)
  fechaLimite          DateTime?
  /// Referencias autorizadas a evidencia/recursos (punteros), sin copiar datos sensibles.
  referencias          Json        @default("[]")
  /// Alcance que acompaña al mensaje; NUNCA amplía atribuciones (validado en servicio).
  permisos             Json        @default("{}")
  /// Hechos de ciclo de vida como registros distintos (RF35).
  enviadoAt            DateTime    @default(now())
  recibidoAt           DateTime?
  aceptadoAt           DateTime?
  resueltoAt           DateTime?
  /// Para rechazo/devolución/escalamiento: código/razón auditable.
  motivo               String?
  /// Actores de los hechos (referencias blandas; auditoría de quién hizo qué).
  recibidoPorAgentId   String?
  aceptadoPorAgentId   String?
  createdAt            DateTime    @default(now())

  @@unique([workspaceId, messageId])
  @@index([workspaceId, correlationId])
  @@index([workspaceId, tareaId])
  @@index([workspaceId, destinatarioAgentId])
  @@index([workspaceId, fechaLimite])
}

/// Contrato de transferencia / continuidad de tarea (RF09, requisito del dueño). Un agente lleva la tarea hasta un
/// punto de corte y cierra el segmento con el estado alcanzado + entregable parcial + contexto autorizado + criterio
/// del siguiente paso + responsable entrante; otro agente o grupo continúa desde ese estado SIN rehacer. El receptor
/// ACEPTA (encola el siguiente segmento con el estado persistido como entrada) o RECHAZA (devuelve/escala). La unicidad
/// `(workspaceId, tareaId, secuenciaSegmento)` evita rehacer o duplicar un segmento ya transferido (idempotencia).
model ContratoTransferencia {
  id                        String              @id @default(cuid())
  workspaceId               String
  workspace                 Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tareaId                   String
  tarea                     Tarea               @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  secuenciaSegmento         Int
  fromAgentId               String?
  toAgentId                 String?
  toEquipoId                String?
  /// Snapshot/referencias del estado persistido de la tarea en el punto de corte (entrada del siguiente segmento).
  estadoAlcanzado           Json                @default("{}")
  entregableParcial         Json?
  /// Contexto autorizado: referencias, no copia de datos sensibles (RF35).
  contextoAutorizado        Json                @default("[]")
  criterioSiguiente         String?
  /// Permisos del tramo entrante; NUNCA amplía atribuciones.
  permisos                  Json                @default("{}")
  responsableEntranteUserId String?
  /// Flujo que ejecuta el segmento entrante al aceptar (referencia blanda a `Workflow`).
  workflowId                String?
  estado                    EstadoTransferencia @default(PROPUESTO)
  motivoRechazo             String?
  /// `MensajeAgente` de tipo HANDOFF que acompaña la propuesta.
  mensajeId                 String?
  /// `Execution` del segmento encolado al aceptar (trazabilidad de quién continuó).
  executionId               String?
  profundidadDelegacion     Int                 @default(0)
  createdAt                 DateTime            @default(now())
  decididoAt                DateTime?

  @@unique([workspaceId, tareaId, secuenciaSegmento])
  @@index([workspaceId, tareaId])
  @@index([workspaceId, estado])
}

/// Canal de coordinación transversal por misión/proceso/área (RF36). Mencionar/referenciar NO concede acceso (QA12):
/// el alcance se valida en consulta y entrega, no por visibilidad. Un canal entre empresas exige permiso explícito.
model Canal {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orgUnitId   String?
  tipo        TipoCanal
  misionId    String?
  nombre      String
  descripcion String?
  validFrom   DateTime    @default(now())
  validTo     DateTime?
  hilos       HiloCanal[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([workspaceId, tipo])
}

/// Hilo dentro de un canal (RF36). Una solicitud de acción NO ejecuta sola: se convierte en una `Tarea` autorizada
/// (D5) solo tras validación de autoridad y aceptación. `tareaId` enlaza el hilo con la tarea en que se convirtió.
model HiloCanal {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  canalId      String
  canal        Canal     @relation(fields: [canalId], references: [id], onDelete: Cascade)
  asunto       String
  /// Nº de intercambios registrados en el hilo (prevención de ruido/ciclos, RF36).
  intercambios Int       @default(0)
  /// Tarea autorizada en la que se convirtió una solicitud del hilo (null = aún no convertida).
  tareaId      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workspaceId, canalId])
}

// --- Gobierno de acciones (E6 · ADR 0013 D1-D4) ---

/// Efecto de una política/decisión. Gana el control más restrictivo: DENY > REQUIRE_APPROVAL(2) > REQUIRE_APPROVAL(1) > ALLOW.
enum PolicyEffect {
  ALLOW
  DENY
  REQUIRE_APPROVAL
}

/// Ciclo de vida de una política. Un cambio no reescribe: archiva la versión vigente y crea otra (RF11).
enum PolicyStatus {
  BORRADOR
  ACTIVA
  ARCHIVADA
}

enum ApprovalRisk {
  BAJO
  MEDIO
  ALTO
}

/// Estados de una aprobación (RF12). PENDIENTE → APROBADA|RECHAZADA|AJUSTE → EJECUTADA|CADUCADA|INVALIDADA.
enum ApprovalStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
  AJUSTE
  EJECUTADA
  CADUCADA
  INVALIDADA
}

/// Alcance de una suspensión de emergencia (RF13).
enum SuspensionScope {
  AGENTE
  PROCESO
  CONECTOR
  ORGANIZACION
}

/// Regla de política declarativa y versionada (RF11). El selector es JSON validado (NUNCA `eval`). Un cambio crea una
/// versión nueva (la anterior pasa a ARCHIVADA), de modo que cada `DecisionPolitica` referencia una versión inmutable.
model Politica {
  id                String       @id @default(cuid())
  workspaceId       String
  workspace         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Empresa (OrgUnit tipo EMPRESA) a la que aplica; null = todo el workspace. Referencia blanda.
  empresaId         String?
  nombre            String
  /// Tipo de acción al que aplica (EMAIL_SEND | PAYMENT | DATA_DELETE | ...). Texto abierto y extensible.
  tipoAccion        String
  /// Selector declarativo: agente/usuario/org/recurso/destinatario/monto/dato/horario.
  selector          Json         @default("{}")
  efecto            PolicyEffect
  /// Nº de aprobaciones distintas requeridas cuando el efecto es REQUIRE_APPROVAL (1 o 2).
  requiredApprovals Int          @default(1)
  /// Si el solicitante puede aprobarse a sí mismo (por defecto NO; aplica también al superempleado, RF40/QA13).
  allowSelfApproval Boolean      @default(false)
  version           Int          @default(1)
  vigenteDesde      DateTime     @default(now())
  vigenteHasta      DateTime?
  estado            PolicyStatus @default(ACTIVA)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([workspaceId, tipoAccion, estado])
  @@index([workspaceId, empresaId])
}

/// Registro inmutable de cada evaluación del motor de políticas (feeds AuditLog, E13). Nunca guarda razonamiento del
/// modelo, solo hechos estructurados y códigos auditables.
model DecisionPolitica {
  id                String       @id @default(cuid())
  workspaceId       String
  workspace         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tipoAccion        String
  actionContextHash String
  efecto            PolicyEffect
  requiredApprovals Int          @default(0)
  /// Qué políticas/versiones dispararon la decisión: [{ policyId, version, efecto, requiredApprovals }].
  policyVersions    Json         @default("[]")
  /// Código auditable del motivo (p. ej. DENEGACION_POR_DEFECTO, SUSPENDIDO), nunca texto libre del modelo.
  motivo            String
  aprobacionId      String?
  createdAt         DateTime     @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, actionContextHash])
}

/// Bandeja de aprobaciones (RF12). El `contentHash` fija el contenido aprobado; recomputarlo al ejecutar detecta
/// cualquier cambio (QA03). `decisiones` lleva las firmas (dos distintas si requiredApprovals=2; sin autoaprobación).
model Aprobacion {
  id                 String         @id @default(cuid())
  workspaceId        String
  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  empresaId          String?
  /// Tarea de negocio (E4) que la originó. Referencia blanda.
  tareaId            String?
  proposito          String?
  tipoAccion         String
  /// Operación/plantilla + parámetros exactos.
  operacion          Json           @default("{}")
  /// Identidad de ejecución: { agentId, agentVersionId, herramienta }.
  identidadEjec      Json           @default("{}")
  destinatarios      Json           @default("[]")
  contenido          Json           @default("{}")
  adjuntos           Json?
  contentHash        String
  importe            Decimal?       @db.Decimal(18, 2)
  moneda             String?
  riesgo             ApprovalRisk   @default(MEDIO)
  evidencia          Json?
  requiredApprovals  Int            @default(1)
  allowSelfApproval  Boolean        @default(false)
  /// Solicitante (humano y/o agente) para prohibir la autoaprobación. Referencias blandas.
  solicitanteUserId  String?
  solicitanteAgentId String?
  /// Unidad para revalidar presupuesto antes del efecto (reutiliza `budgets`). Referencia blanda.
  orgUnitId          String?
  /// Firmas: [{ actorUserId, decision, comentario, at }]. Dos actorUserId distintos si requiredApprovals=2.
  decisiones         Json           @default("[]")
  estado             ApprovalStatus @default(PENDIENTE)
  expiresAt          DateTime
  decisionPoliticaId String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([workspaceId, estado])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, tareaId])
}

/// Interruptor de emergencia por agente/proceso/conector/organización (RF13). El `ActionGateway` consulta las activas
/// antes de todo efecto. La reactivación exige actor + motivo; todo queda registrado.
model Suspension {
  id               String          @id @default(cuid())
  workspaceId      String
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  alcance          SuspensionScope
  /// Id del agente/flujo/conector/empresa alcanzado. Referencia blanda.
  targetId         String
  activa           Boolean         @default(true)
  motivo           String
  actorUserId      String?
  createdAt        DateTime        @default(now())
  reactivadaPor    String?
  reactivadaMotivo String?
  reactivadaAt     DateTime?

  @@index([workspaceId, activa])
  @@index([workspaceId, alcance, targetId])
}

// ===================== Durabilidad avanzada (E7 · ADR 0012/0013) =====================

/// Estado de una clave de idempotencia (RF17/RF20). EN_PROGRESO mientras el efecto corre; COMPLETADA guarda el
/// resultado para devolverlo ante una repetición sin re-ejecutar (QA04); FALLIDA permite reintentar según clasificación.
enum EstadoIdempotencia {
  EN_PROGRESO
  COMPLETADA
  FALLIDA
}

/// Clasificación pura de un fallo (RF20). TEMPORAL se reintenta (solo si la operación es segura/idempotente);
/// PERMANENTE no se reintenta; INCIERTO no se repite a ciegas, se CONCILIA. No se promete exactly-once sobre sistemas
/// externos que no lo garanticen: una escritura incierta se verifica contra el destino o va a la bandeja de excepciones.
enum ClaseFallo {
  TEMPORAL
  PERMANENTE
  INCIERTO
}

/// Estados de una excepción operativa (RF21). ABIERTA al nacer; EN_PROGRESO cuando alguien la trabaja; CONCILIADA tras
/// verificar el destino; REASIGNADA/CANCELADA/RESUELTA por acción del dueño. El historial vive en `ExcepcionEvento`.
enum EstadoExcepcion {
  ABIERTA
  EN_PROGRESO
  CONCILIADA
  REASIGNADA
  CANCELADA
  RESUELTA
}

/// Clave de idempotencia por operación de negocio (RF17/RF20). Una repetición (redelivery / reejecución) con la misma
/// clave NO vuelve a ejecutar el efecto: devuelve el resultado previo (QA04). La reutiliza el `ActionGateway` (E6) en su
/// punto de despacho para que un reintento o reentrega no duplique el efecto de negocio.
model IdempotencyKey {
  id          String             @id @default(cuid())
  workspaceId String
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Clave de negocio provista por el llamador (p. ej. messageId, aprobacionId, providerRef del canal).
  clave       String
  /// Scope/operación a la que pertenece la clave (p. ej. ACTION_DISPATCH:EMAIL_SEND). Para consulta/auditoría.
  scope       String
  estado      EstadoIdempotencia @default(EN_PROGRESO)
  /// Resultado serializado del efecto, para devolverlo sin re-ejecutar (QA04).
  resultado   Json?
  /// Hash del contenido asociado: detecta una colisión de clave con contenido distinto.
  hash        String?
  /// Vigencia (RF20): pasada esta fecha la clave caduca y una repetición muy posterior puede re-ejecutarse.
  expiresAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([workspaceId, clave])
  @@index([workspaceId, scope])
  @@index([workspaceId, estado])
}

/// Bandeja de excepciones (RF21): fallos del motor durable y escrituras inciertas que requieren intervención. Lleva
/// causa, impacto, proceso/tarea/paso, evidencia (referencia, no copia), dueño, antigüedad (`createdAt`), siguiente
/// acción y estado. Conserva historial append-only en `ExcepcionEvento`; reintentar no duplica acciones ya confirmadas
/// (protegido por la clave de idempotencia asociada, QA06).
model Excepcion {
  id               String            @id @default(cuid())
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Empresa (OrgUnit tipo EMPRESA) a la que pertenece; null = todo el workspace. Referencia blanda.
  empresaId        String?
  /// Causa (código/razón auditable, nunca razonamiento del modelo).
  causa            String
  clase            ClaseFallo?
  impacto          String?
  /// Proceso/flujo, tarea, ejecución y paso/nodo afectados. Referencias blandas.
  procesoId        String?
  tareaId          String?
  executionId      String?
  paso             String?
  /// Evidencia referenciada (NO copia de datos sensibles): { executionId, providerRef, stepId, ... }.
  evidencia        Json              @default("{}")
  /// Dueño humano asignado a la excepción. Referencia blanda.
  duenoUserId      String?
  siguienteAccion  String?
  /// Origen: MOTOR_DURABLE | ESCRITURA_INCIERTA | MANUAL.
  origen           String            @default("MANUAL")
  /// Clave de idempotencia de la acción asociada: al reintentar, evita duplicar un efecto ya confirmado (QA06).
  idempotencyKeyId String?
  estado           EstadoExcepcion   @default(ABIERTA)
  eventos          ExcepcionEvento[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([workspaceId, estado])
  @@index([workspaceId, tareaId])
  @@index([workspaceId, createdAt])
}

/// Evento append-only del historial de una excepción (RF21): aporte de info, reintento, reasignación, cancelación,
/// conciliación. Reintentar CONSERVA el historial (los eventos no se borran) y registra si la acción ya estaba
/// confirmada (QA06).
model ExcepcionEvento {
  id          String    @id @default(cuid())
  workspaceId String
  excepcionId String
  excepcion   Excepcion @relation(fields: [excepcionId], references: [id], onDelete: Cascade)
  /// Tipo: CREADA | INFO | REINTENTO | REASIGNACION | CANCELACION | CONCILIACION.
  tipo        String
  detalle     Json      @default("{}")
  actorUserId String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, excepcionId])
}
