// Nexo — modelo de datos
// Multi-tenant por Workspace: todo recurso de negocio pertenece a un workspace.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum ConnectorType {
  REST
  SOAP
  GRAPHQL
  MCP
  DATABASE
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum LlmKind {
  ANTHROPIC
  OPENAI_COMPATIBLE
  MOCK
}

/// Cómo se autentica una conexión LLM: clave estática o token OAuth renovable (ADR 0002, D8).
enum LlmCredentialType {
  API_KEY
  OAUTH
}

/// Flujo de conexión de un proveedor LLM en curso (OAuth con redirección o código de dispositivo).
enum LlmAuthFlowType {
  OAUTH
  DEVICE_CODE
}

enum ModelTier {
  PREMIUM
  STANDARD
  ECONOMY
}

enum BudgetPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum BudgetPolicy {
  BLOCK
  DOWNGRADE
  ALERT_ONLY
}

enum UsageSource {
  CHAT
  WORKFLOW
  MCP
  ROUTINE
  EVAL
  COPILOT
}

enum AgentVisibility {
  PRIVATE
  TEAM
  WORKSPACE
}

enum SharePrincipal {
  USER
  UNIT
  /// Grupo de usuarios del workspace (p. ej. "Gerentes de línea"), ADR 0007 D6.
  GROUP
}

enum SharePermission {
  USE
  EDIT
}

/// Ciclo de vida del empleado digital (RF05/RF06). Ampliación aditiva y retrocompatible de DRAFT/LAUNCHED:
/// DRAFT=Borrador, EN_VALIDACION=En validación, LAUNCHED=Publicado, SUSPENDIDO=Suspendido, RETIRADO=Retirado.
/// Solo LAUNCHED publica por MCP y ejecuta rutinas (ADR 0006); el resto de estados no.
enum LaunchStatus {
  DRAFT
  EN_VALIDACION
  LAUNCHED
  SUSPENDIDO
  RETIRADO
}

/// Nivel jerárquico de un cargo (RF03, base de la jerarquía de dirección digital E3/RF32).
enum NivelJerarquico {
  EMPLEADO
  LIDER
  JEFE
  DIRECTOR
  GERENTE
  SUPEREMPLEADO
}

/// Tipo de nodo del árbol organizacional (ADR 0011 D2). Discriminador de la dimensión jerárquica/funcional. El valor
/// por defecto `AREA_FUNCIONAL` conserva la semántica de las unidades ya existentes (retrocompatibilidad).
enum OrgUnitTipo {
  GRUPO
  EMPRESA
  UNIDAD_NEGOCIO
  AREA_FUNCIONAL
  DEPARTAMENTO
  EQUIPO
}

/// Estado de vigencia de una pieza de estructura organizacional (ADR 0011 D2/D3/D4).
enum EstadoEstructura {
  ACTIVA
  SUSPENDIDA
  CERRADA
}

/// Tipo de relación matricial entre un sujeto (agente o miembro) y una dimensión destino (ADR 0011 D4). A lo sumo una
/// `FUNCIONAL_PRINCIPAL` vigente por sujeto (RF42): se garantiza con un índice parcial único creado por SQL manual.
enum TipoAsignacion {
  FUNCIONAL_PRINCIPAL
  LINEA
  SEDE
  PROYECTO
  SERVICIO
}

/// Política de DataGuard hacia los modelos de IA (ADR 0008 D2).
enum DataGuardMode {
  OFF
  MASK
  BLOCK
}

enum CopilotMode {
  CREATE
  IMPROVE
  DIAGNOSE
}

enum CopilotProposalKind {
  CREATE_AGENT
  UPDATE_AGENT
}

enum FeedbackRating {
  UP
  DOWN
}

enum ReviewStatus {
  PENDING
  APPROVED
  DISCARDED
}

enum EvalRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum SuggestionStatus {
  PENDING
  APPLIED
  REJECTED
}

enum KnowledgeSourceType {
  TEXT
  URL
  FILE
}

enum DocumentStatus {
  READY
  FAILED
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// Estado de una ejecución de agente registrada en `AgentRun` (instrumentación RX-14).
enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum TriggerType {
  MANUAL
  WEBHOOK
  SCHEDULE
  AGENT
  MCP
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  name                 String
  passwordHash         String
  /// Cuándo demostró controlar el correo (enlace de verificación o de invitación). Null = sin verificar: puede usar su
  /// propio workspace, pero no unirse a otros sin el token de una invitación ni ser administrador de la plataforma.
  emailVerifiedAt      DateTime?
  /// Versión de las sesiones: va en el JWT (`tv`); incrementarla invalida todos los tokens emitidos antes.
  tokenVersion         Int                  @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  memberships          Membership[]
  groupMemberships     UserGroupMember[]
  invitationsSent      Invitation[]         @relation("InvitationInviter")
  invitationsAccepted  Invitation[]         @relation("InvitationAcceptor")
  apiKeysCreated       ApiKey[]             @relation("ApiKeyCreator")
  passwordResets       PasswordResetToken[]
  responsibleForAgents Agent[]              @relation("AgentResponsible")
  substituteForAgents  Agent[]              @relation("AgentSubstitute")
}

/// Invitación a un workspace (C1): la membresía solo se crea cuando el dueño del correo acepta con el token de un solo
/// uso (se guarda su SHA-256). Una sola invitación activa por (workspace, correo): invitar de nuevo revoca la anterior.
model Invitation {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Correo normalizado (trim + minúsculas).
  email        String
  /// Nombre sugerido por quien invita (la persona puede cambiarlo al aceptar).
  name         String?
  role         Role
  orgUnitId    String?
  orgUnit      OrgUnit?  @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  tokenHash    String    @unique
  expiresAt    DateTime
  invitedById  String?
  invitedBy    User?     @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedAt   DateTime?
  acceptedById String?
  acceptedBy   User?     @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([workspaceId, email])
}

model Workspace {
  id                        String          @id @default(cuid())
  name                      String
  slug                      String          @unique
  /// Permite que cualquier miembro cree agentes personales (ADR 0007).
  allowPersonalAgents       Boolean         @default(true)
  /// Política de DataGuard hacia los modelos de IA (ADR 0008 D2).
  dataGuardMode             DataGuardMode   @default(MASK)
  /// Días que se conservan conversaciones y mensajes (ADR 0008 D7; null = sin límite).
  conversationRetentionDays Int?
  /// Última vez que el workspace guardó sus ajustes de protección de datos (null = rige CONVERSATIONS_RETENTION_DAYS).
  privacySettingsUpdatedAt  DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  memberships               Membership[]
  connectors                Connector[]
  agents                    Agent[]
  userGroups                UserGroup[]
  workflows                 Workflow[]
  executions                Execution[]
  apiKeys                   ApiKey[]
  secrets                   Secret[]
  llmConnections            LlmConnection[]
  llmAuthFlows              LlmAuthFlow[]
  orgUnits                  OrgUnit[]
  usage                     UsageRecord[]
  agentRuns                 AgentRun[]
  skills                    Skill[]
  knowledgeBases            KnowledgeBase[]
  agentRoutines             AgentRoutine[]
  edgeAgents                EdgeAgent[]
  invitations               Invitation[]
  cargos                    Cargo[]
  lineasNegocio             LineaNegocio[]
  sedes                     Sede[]
  centrosCosto              CentroCosto[]
  asignaciones              AsignacionOrganizacional[]
  objetivos                 Objetivo[]
  tareas                    Tarea[]
  contratosResultado        ContratoResultado[]
  evidencias                Evidencia[]
  incumplimientos           Incumplimiento[]
}

/// Catálogo de cargos (RF03): perfil reutilizable del empleado digital con propósito, funciones, entregables,
/// indicadores, límites y nivel jerárquico. Un cargo describe la posición, no a la persona ni al agente concreto.
model Cargo {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nombre      String
  /// Propósito o misión del cargo.
  proposito   String?
  /// Funciones principales del cargo.
  funciones   String[]        @default([])
  /// Entregables o productos esperados.
  entregables String[]        @default([])
  /// Indicadores con los que se mide el desempeño del cargo.
  indicadores String[]        @default([])
  /// Límites: lo que el cargo NO debe hacer.
  limites     String[]        @default([])
  /// Nivel jerárquico (base de la jerarquía de dirección digital E3/RF32).
  nivel       NivelJerarquico @default(EMPLEADO)
  /// Un cargo inactivo deja de ofrecerse para asignar, sin romper los agentes que ya lo tienen.
  activo      Boolean         @default(true)
  agents      Agent[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([workspaceId])
}

model Membership {
  id          String    @id @default(cuid())
  role        Role      @default(EDITOR)
  userId      String
  workspaceId String
  /// Unidad corporativa a la que se imputa el consumo del usuario (null = raíz).
  orgUnitId   String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orgUnit     OrgUnit?  @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@unique([userId, workspaceId])
}

/// Llaves de API para integraciones máquina-a-máquina (webhooks, servidor MCP).
/// API key de integraciones (B3): alcance acotado, rol máximo y expiración. Solo se guarda el SHA-256.
model ApiKey {
  id            String    @id @default(cuid())
  name          String
  prefix        String
  hash          String    @unique
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Permisos (`read`, `write`, `agents:run`, `workflows:run`, `connectors:invoke`, `mcp`). `*` = alcance completo
  /// heredado de las claves anteriores a B3: la web sugiere rotarlas. Vacío = ninguna acción.
  scopes        String[]  @default([])
  /// Rol máximo efectivo de la clave; en uso se limita además al rol vigente de quien la creó.
  role          Role      @default(EDITOR)
  /// Null = sin expiración (solo un OWNER lo decide; las claves anteriores a B3 quedaron así).
  expiresAt     DateTime?
  revokedAt     DateTime?
  /// Motivo de la revocación (`manual`, `account_takeover`).
  revokedReason String?
  /// Quién la creó. Null en las claves anteriores a B3 (o si se eliminó la cuenta).
  createdById   String?
  createdBy     User?     @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([workspaceId])
  @@index([createdById])
}

/// Enlace de recuperación de contraseña (C1/B3): de un solo uso, 30 minutos; solo se guarda el SHA-256 del token.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Credenciales cifradas (AES-256-GCM). Nunca se devuelven en claro por la API.
model Secret {
  id          String    @id @default(cuid())
  name        String
  ciphertext  String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, name])
}

/// Sistema externo: API REST, servicio SOAP, endpoint GraphQL o servidor MCP.
model Connector {
  id             String               @id @default(cuid())
  name           String
  description    String?
  type           ConnectorType
  /// Configuración específica del tipo (baseUrl, wsdl, transporte MCP, headers...).
  config         Json                 @default("{}")
  /// Autenticación: { type: none|apiKey|bearer|basic|oauth2, ... } con referencias a secretos.
  auth           Json                 @default("{\"type\":\"none\"}")
  /// Integración del catálogo que originó el conector (ADR 0005), si aplica.
  catalogId      String?
  /// Secretos de la bóveda que el conector puede resolver (auditoría A4). Solo un ADMIN amplía la lista.
  allowedSecrets String[]             @default([])
  workspaceId    String
  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  operations     ConnectorOperation[]
  oauth          OAuthCredential?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([workspaceId])
}

/// Operación invocable de un conector. Cada operación se expone como "tool" para agentes.
model ConnectorOperation {
  id          String      @id @default(cuid())
  key         String
  name        String
  description String?
  /// JSON Schema de entrada.
  inputSchema Json        @default("{\"type\":\"object\",\"properties\":{}}")
  /// Definición: REST {method,path,query,headers,body}; SOAP {action,bodyTemplate}; GraphQL {query}; MCP {toolName}.
  definition  Json        @default("{}")
  connectorId String
  connector   Connector   @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  agentTools  AgentTool[]

  @@unique([connectorId, key])
}

model Agent {
  id                   String             @id @default(cuid())
  name                 String
  description          String?
  /// Nombre de un ícono del design system (p. ej. "inbox"); null = sin ícono (la web muestra "bot").
  icon                 String?
  provider             String             @default("anthropic")
  model                String             @default("claude-opus-5-5")
  systemPrompt         String             @default("")
  /// low | medium | high | xhigh | max
  effort               String             @default("medium")
  maxTurns             Int                @default(12)
  /// Perfil estructurado: { role, goals[], responsibilities[], boundaries[], tone, outputFormat, language } (ADR 0003).
  profile              Json               @default("{}")
  /// Cadena de respaldo "<providerId>:<modelId>" (máx. 3).
  fallbackModels       String[]           @default([])
  /// Política de enrutamiento multi-modelo (ADR 0010). null = comportamiento actual (principal + fallbackModels).
  routing              Json?
  /// Meta de calidad del bucle de mejora (0..1, ADR 0004).
  targetScore          Float              @default(0.85)
  /// Ciclo de vida de producción (ADR 0006): solo los agentes LAUNCHED se publican por MCP y ejecutan rutinas.
  launchStatus         LaunchStatus       @default(DRAFT)
  launchedAt           DateTime?
  launchOverrideReason String?
  /// Visibilidad y propiedad (ADR 0007).
  visibility           AgentVisibility    @default(PRIVATE)
  ownerId              String?
  shares               AgentShare[]
  /// Centro de costo cuando el agente corre sin usuario (flujos, webhooks, MCP).
  costCenterId         String?
  costCenter           OrgUnit?           @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  /// Expediente del empleado digital (RF02/RF04). Cargo que desempeña (perfil reutilizable), responsable humano
  /// titular y suplente. Un agente no puede publicarse sin responsable (RF06).
  cargoId              String?
  cargo                Cargo?             @relation(fields: [cargoId], references: [id], onDelete: SetNull)
  responsableUserId    String?
  responsableUser      User?              @relation("AgentResponsible", fields: [responsableUserId], references: [id], onDelete: SetNull)
  suplenteUserId       String?
  suplenteUser         User?              @relation("AgentSubstitute", fields: [suplenteUserId], references: [id], onDelete: SetNull)
  workspaceId          String
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tools                AgentTool[]
  conversations        Conversation[]
  skills               AgentSkill[]
  knowledge            AgentKnowledge[]
  examples             AgentExample[]
  routines             AgentRoutine[]
  feedback             MessageFeedback[]
  evalCases            EvalCase[]
  evalRuns             EvalRun[]
  versions             AgentVersion[]
  suggestions          PromptSuggestion[]
  runs                 AgentRun[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([workspaceId])
}

/// Registro persistente de cada ejecución de un agente (instrumentación defensiva, RX-14): da los KPIs reales
/// (tasa de éxito, duración, latencia al primer token) y la base del historial de tareas. Su escritura NUNCA
/// afecta ni bloquea la ejecución del agente: un fallo al registrar se loguea y se ignora.
model AgentRun {
  id             String         @id @default(cuid())
  workspaceId    String
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Usuario que originó la ejecución (null cuando corre sin usuario: flujos, webhooks, MCP).
  userId         String?
  source         UsageSource
  status         AgentRunStatus @default(RUNNING)
  error          String?
  model          String?
  providerId     String?
  startedAt      DateTime       @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  /// Tiempo hasta el primer token (primer evento de texto o tool del stream), en ms.
  ttftMs         Int?
  costUsd        Decimal?       @db.Decimal(18, 8)
  inputTokens    Int?
  outputTokens   Int?
  /// Datos enmascarados por DataGuard durante la ejecución (null si no se instrumenta).
  maskedCount    Int?
  conversationId String?
  executionId    String?
  createdAt      DateTime       @default(now())

  @@index([workspaceId, agentId, createdAt])
  @@index([workspaceId, createdAt])
}

model AgentTool {
  id               String             @id @default(cuid())
  agentId          String
  operationId      String
  /// Si es true, la llamada requiere aprobación humana (human-in-the-loop).
  requiresApproval Boolean            @default(false)
  agent            Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  operation        ConnectorOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([agentId, operationId])
}

model Conversation {
  id        String   @id @default(cuid())
  title     String   @default("Nueva conversación")
  /// Usuario dueño de la conversación (ADR 0007: las conversaciones son privadas).
  userId    String?
  /// Proveedor que produjo el historial (los formatos no son intercambiables).
  provider  String   @default("anthropic")
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Historial completo en formato del proveedor (append-only).
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId, userId])
  @@index([updatedAt])
}

/// Flujo de automatización como grafo dirigido (nodos + aristas).
model Workflow {
  id              String            @id @default(cuid())
  name            String
  description     String?
  active          Boolean           @default(false)
  /// { nodes: WorkflowNode[], edges: WorkflowEdge[] }
  definition      Json              @default("{\"nodes\":[],\"edges\":[]}")
  /// Cron para disparador programado (opcional).
  schedule        String?
  /// Token público para disparo vía webhook.
  webhookToken    String            @unique @default(cuid())
  version         Int               @default(1)
  /// Flujo que se dispara cuando una ejecución de este flujo falla (práctica n8n).
  errorWorkflowId String?
  workspaceId     String
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions      Execution[]
  versions        WorkflowVersion[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([workspaceId])
}

model Execution {
  id          String          @id @default(cuid())
  status      ExecutionStatus @default(QUEUED)
  trigger     TriggerType     @default(MANUAL)
  input       Json            @default("{}")
  output      Json?
  error       String?
  /// Bitácora por nodo: [{ nodeId, status, startedAt, finishedAt, input, output, error }]
  steps       Json            @default("[]")
  workflowId  String
  workflow    Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Vínculo opcional y aditivo a la tarea cuyo trabajo ejecuta este flujo (E4/RF08). `null` = ejecución sin tarea
  /// (comportamiento previo intacto). Una tarea puede tener varias ejecuciones (segmentos del handoff llegan en E5).
  tareaId     String?
  tarea       Tarea?          @relation(fields: [tareaId], references: [id], onDelete: SetNull)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime        @default(now())

  @@index([workspaceId, createdAt])
  @@index([workflowId])
  @@index([tareaId])
}

// ===================== Gobierno de IA (ADR 0002) =====================

/// Conexión a un proveedor LLM configurada por el administrador.
model LlmConnection {
  id                 String            @id @default(cuid())
  name               String
  kind               LlmKind
  baseUrl            String?
  /// API key cifrada con AES-256-GCM.
  apiKeyCipher       String?
  enabled            Boolean           @default(true)
  /// Id de la entrada del catálogo de proveedores (ADR 0002, D8). Null = conexión manual anterior al catálogo.
  providerId         String?
  /// Valores no secretos del formulario del catálogo (p. ej. recurso de Azure, región de Bedrock).
  providerFields     Json?
  /// Cabeceras HTTP adicionales no secretas que el driver envía en cada llamada.
  headers            Json?
  /// Opciones del driver: { authHeader: 'bearer' | 'api-key' | 'none', verifyPath, replayReasoning }.
  driverOptions      Json?
  /// API_KEY: `apiKeyCipher` es una clave estática. OAUTH: es el access token vigente y se renueva con el refresh token.
  credentialType     LlmCredentialType @default(API_KEY)
  /// Refresh token OAuth cifrado con AES-256-GCM (null si el proveedor no lo entrega).
  oauthRefreshCipher String?
  /// Expiración del access token OAuth (se renueva 60 s antes).
  oauthExpiresAt     DateTime?
  oauthScope         String?
  workspaceId        String
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  models             LlmModel[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, providerId])
}

/// Modelo habilitado en una conexión, con su tarifa (USD por millón de tokens).
model LlmModel {
  id                  String        @id @default(cuid())
  modelId             String
  label               String
  tier                ModelTier     @default(STANDARD)
  inputUsdPerMTok     Decimal       @db.Decimal(12, 6)
  outputUsdPerMTok    Decimal       @db.Decimal(12, 6)
  cacheReadUsdPerMTok Decimal?      @db.Decimal(12, 6)
  enabled             Boolean       @default(true)
  /// Importado sin tarifa verificada (precio 0): la consola pide completarla.
  needsPricing        Boolean       @default(false)
  /// Especialidades verificadas en la fuente oficial: CODE | REASONING | VISION | FAST | GENERAL.
  specialties         String[]      @default([])
  /// Ventana de contexto en tokens (null si no está verificada).
  contextTokens       Int?
  connectionId        String
  connection          LlmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([connectionId, modelId])
}

/// Flujo de conexión de un proveedor LLM en curso (ADR 0002, D8). Guarda en servidor lo que no debe viajar por el
/// navegador (device_code cifrado) y los datos del formulario hasta que el proveedor responde. Vida corta (≤ 15 min).
model LlmAuthFlow {
  id               String          @id @default(cuid())
  type             LlmAuthFlowType
  providerId       String
  userId           String
  /// Nombre de la conexión y valores no secretos del formulario (p. ej. proyecto y región de Vertex).
  name             String?
  fields           Json?
  models           String[]        @default([])
  /// device_code cifrado (solo DEVICE_CODE, mientras `status = pending`).
  deviceCodeCipher String?
  /// Tokens emitidos y cuenta autorizada, cifrados, mientras esperan la confirmación del ADMIN (`status = confirm`).
  pendingCipher    String?
  intervalSec      Int?
  nextPollAt       DateTime?
  /// pending | confirm | confirming | connected | expired | denied | cancelled
  status           String          @default("pending")
  connectionId     String?
  expiresAt        DateTime
  workspaceId      String
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())

  @@index([workspaceId])
  @@index([expiresAt])
}

/// Unidad corporativa (árbol). La raíz (parentId = null) es el tope global del workspace.
model OrgUnit {
  id            String         @id @default(cuid())
  name          String
  code          String?
  /// Modelos permitidos "<providerId>:<modelId>". Vacío = hereda del padre.
  allowedModels String[]       @default([])
  parentId      String?
  parent        OrgUnit?       @relation("OrgTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      OrgUnit[]      @relation("OrgTree")
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Dimensión jerárquica/funcional (ADR 0011 D2). Las unidades previas migran a `AREA_FUNCIONAL` (default neutro).
  tipo              OrgUnitTipo      @default(AREA_FUNCIONAL)
  /// Empresa (OrgUnit `EMPRESA`) a la que pertenece la unidad. Desnormalizado para filtrar barato por empresa
  /// (ADR 0011 D1/D2). `null` en las unidades ya existentes (retrocompatible). Referencia blanda: se valida en servicio.
  empresaId         String?
  /// Responsable humano de la unidad (RF43). Referencia blanda a `User` (no concede acceso: ADR 0011 D6).
  responsableUserId String?
  /// Estado de vigencia de la unidad (ADR 0011 D2). Las unidades previas quedan `ACTIVA`.
  estado            EstadoEstructura @default(ACTIVA)
  /// Vigencia de la unidad (RF43). Opcionales; `null` = sin límite.
  vigenteDesde      DateTime?
  vigenteHasta      DateTime?
  memberships   Membership[]
  agents        Agent[]
  budget        Budget?
  ledger        BudgetLedger[]
  alerts        BudgetAlert[]
  usage         UsageRecord[]
  invitations   Invitation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, tipo])
  @@index([workspaceId, empresaId])
}

/// Bolsa de presupuesto de una unidad (descuenta también el consumo de sus descendientes).
model Budget {
  id                  String       @id @default(cuid())
  orgUnitId           String       @unique
  orgUnit             OrgUnit      @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  period              BudgetPeriod @default(MONTHLY)
  limitUsd            Decimal      @db.Decimal(18, 8)
  policy              BudgetPolicy @default(BLOCK)
  alertThresholds     Int[]        @default([50, 80, 100])
  downgradeProviderId String?
  downgradeModel      String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

/// Gasto acumulado por unidad y periodo (incluye descendientes). Incrementos atómicos.
model BudgetLedger {
  orgUnitId String
  orgUnit   OrgUnit  @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  periodKey String
  spentUsd  Decimal  @default(0) @db.Decimal(18, 8)
  updatedAt DateTime @updatedAt

  @@id([orgUnitId, periodKey])
}

model BudgetAlert {
  id        String   @id @default(cuid())
  orgUnitId String
  orgUnit   OrgUnit  @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  periodKey String
  threshold Int
  spentUsd  Decimal  @db.Decimal(18, 8)
  limitUsd  Decimal  @db.Decimal(18, 8)
  createdAt DateTime @default(now())

  @@unique([orgUnitId, periodKey, threshold])
}

/// Registro de consumo por llamada al modelo. No guarda contenido de prompts ni respuestas.
model UsageRecord {
  id               String      @id @default(cuid())
  workspaceId      String
  workspace        Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orgUnitId        String?
  orgUnit          OrgUnit?    @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  userId           String?
  agentId          String?
  workflowId       String?
  executionId      String?
  conversationId   String?
  source           UsageSource
  providerId       String
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int         @default(0)
  cacheWriteTokens Int         @default(0)
  costUsd          Decimal     @db.Decimal(18, 8)
  /// Trazabilidad de enrutamiento (ADR 0010 D5): motivo de selección como código(s) auditable(s), nunca el
  /// razonamiento interno del modelo. Varios motivos se separan por coma. `null` = sin política de enrutamiento.
  routingReason    String?
  /// Rol del tramo en la orquestación (ADR 0010 D5): `draft`/`verify`/nombre de rol. `null` sin enrutamiento.
  role             String?
  createdAt        DateTime    @default(now())

  @@index([workspaceId, createdAt])
  @@index([orgUnitId, createdAt])
}

// ===================== Estructura empresarial (ADR 0011 · E1) =====================
// Dimensiones ortogonales al árbol de mando (`OrgUnit`). No forman jerarquía ni conceden acceso por sí mismas
// (ADR 0011 D3/D6). Todo filtra por `workspaceId` (multi-tenant) y referencia su empresa (`OrgUnit` `EMPRESA`) por
// `empresaId`, validado en servicio. El marco de dimensiones configurables (D8) es una cédula aparte.

/// Línea de negocio (dimensión de negocio, ADR 0011 D3/RF41). Cruza áreas y empresas; no reemplaza el sistema de origen.
model LineaNegocio {
  id                String           @id @default(cuid())
  workspaceId       String
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// OrgUnit `EMPRESA` dueña de la línea (referencia blanda, validada en servicio).
  empresaId         String
  codigo            String
  nombre            String
  /// Responsable humano opcional (RF43). No concede acceso (ADR 0011 D6).
  responsableUserId String?
  /// Metas u objetivos comerciales opcionales (no reemplazan el sistema de origen, RF43).
  metas             Json             @default("{}")
  estado            EstadoEstructura @default(ACTIVA)
  vigenteDesde      DateTime?
  vigenteHasta      DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([workspaceId, empresaId, codigo])
  @@index([workspaceId, empresaId])
}

/// Sede (dimensión territorial, ADR 0011 D3/RF41). Es una etiqueta, no un sub-árbol; las áreas no se duplican por sede.
model Sede {
  id                 String           @id @default(cuid())
  workspaceId        String
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  empresaId          String
  codigo             String
  nombre             String
  /// Zona horaria IANA, p. ej. "America/Bogota".
  zonaHoraria        String
  /// Alcance territorial opcional (ciudades, regiones, países que cubre la sede).
  alcanceTerritorial String?
  estado             EstadoEstructura @default(ACTIVA)
  vigenteDesde       DateTime?
  vigenteHasta       DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([workspaceId, empresaId, codigo])
  @@index([workspaceId, empresaId])
}

/// Centro de costo (dimensión económica de reporte, ADR 0011 D3/RF45). Distinto del área; NO es la unidad de reserva
/// de presupuesto (esa sigue siendo `OrgUnit`/`Budget`, ADR 0002 intacto) y NO concede permisos (RF41/D6).
model CentroCosto {
  id             String           @id @default(cuid())
  workspaceId    String
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  empresaId      String
  codigo         String
  nombre         String
  /// Asociación por defecto opcional (referencias blandas; no conceden permisos).
  orgUnitId      String?
  lineaNegocioId String?
  estado         EstadoEstructura @default(ACTIVA)
  vigenteDesde   DateTime?
  vigenteHasta   DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([workspaceId, empresaId, codigo])
  @@index([workspaceId, empresaId])
}

/// Asignación organizacional (la matriz, ADR 0011 D4/RF42). Relaciona un sujeto (exactamente uno de `agentId`/`userId`,
/// validado en servicio) con una dimensión destino, con alcance y vigencia. Identificador estable que sobrevive a la
/// reorganización (QA16). No duplica agentes ni ejecuciones; NO concede acceso a datos por sí misma (D6). A lo sumo una
/// `FUNCIONAL_PRINCIPAL` vigente por sujeto (RF42): índice parcial único creado por SQL manual en la migración.
model AsignacionOrganizacional {
  id              String           @id @default(cuid())
  workspaceId     String
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Sujeto: exactamente uno de los dos (referencias blandas, validadas en servicio).
  agentId         String?
  userId          String?
  tipoAsignacion  TipoAsignacion
  /// Destino según `tipoAsignacion` (referencias blandas): área/equipo, línea, sede o proyecto (futuro).
  orgUnitId       String?
  lineaNegocioId  String?
  sedeId          String?
  proyectoId      String?
  /// Rol en esa dimensión (colaborador | revisor | responsable_proceso ...). Resuelve autoridad (RF33/RF42).
  rol             String?
  /// Qué habilita OPERATIVAMENTE la asignación (procesos/tareas). NUNCA acceso a datos (ADR 0011 D6).
  alcance         Json             @default("{}")
  estado          EstadoEstructura @default(ACTIVA)
  vigenteDesde    DateTime         @default(now())
  vigenteHasta    DateTime?
  creadaPorUserId String?
  createdAt       DateTime         @default(now())

  @@index([workspaceId, agentId])
  @@index([workspaceId, userId])
  @@index([workspaceId, lineaNegocioId])
  // Índice parcial único (SQL manual): a lo sumo una FUNCIONAL_PRINCIPAL vigente (vigenteHasta IS NULL) por sujeto.
}

// ===================== Estudio de agentes y n8n (ADR 0003) =====================

/// Habilidad reutilizable: instrucciones + operaciones, cargada bajo demanda por el agente (load_skill).
model Skill {
  id           String       @id @default(cuid())
  name         String
  slug         String
  description  String
  instructions String
  /// Operaciones de conector que la skill aporta como herramientas.
  operationIds String[]     @default([])
  workspaceId  String
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agents       AgentSkill[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([workspaceId, slug])
}

model AgentSkill {
  agentId String
  skillId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([agentId, skillId])
}

model KnowledgeBase {
  id          String              @id @default(cuid())
  name        String
  description String?
  workspaceId String
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents   KnowledgeDocument[]
  chunks      KnowledgeChunk[]
  agents      AgentKnowledge[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([workspaceId])
}

model AgentKnowledge {
  agentId         String
  knowledgeBaseId String
  // Si es true, el agente puede escribir (aprender) en esta base con la herramienta interna `save_knowledge`.
  canWrite        Boolean       @default(false)
  agent           Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@id([agentId, knowledgeBaseId])
}

model KnowledgeDocument {
  id              String              @id @default(cuid())
  title           String
  sourceType      KnowledgeSourceType
  source          String?
  status          DocumentStatus      @default(READY)
  error           String?
  charCount       Int                 @default(0)
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase       @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks          KnowledgeChunk[]
  createdAt       DateTime            @default(now())

  @@index([knowledgeBaseId])
}

/// Fragmento indexado con búsqueda full-text de PostgreSQL (columna tsvector generada en la migración).
model KnowledgeChunk {
  id              String                   @id @default(cuid())
  ordinal         Int
  content         String
  search          Unsupported("tsvector")?
  documentId      String
  document        KnowledgeDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase            @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId])
}

/// Ejemplo de entrenamiento few-shot (entrada → salida esperada).
model AgentExample {
  id        String   @id @default(cuid())
  input     String
  output    String
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// Tarea recurrente de un agente (cron + instrucción).
model AgentRoutine {
  id               String       @id @default(cuid())
  name             String
  prompt           String
  schedule         String
  timezone         String       @default("UTC")
  enabled          Boolean      @default(true)
  notifyWebhookUrl String?
  lastRunAt        DateTime?
  lastStatus       RunStatus?
  agentId          String
  agent            Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId      String
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs             RoutineRun[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([workspaceId])
}

model RoutineRun {
  id         String       @id @default(cuid())
  status     RunStatus    @default(RUNNING)
  output     String?
  error      String?
  costUsd    Decimal      @default(0) @db.Decimal(18, 8)
  routineId  String
  routine    AgentRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  startedAt  DateTime     @default(now())
  finishedAt DateTime?

  @@index([routineId, startedAt])
}

/// Versión anterior de la definición de un flujo (historial inmutable).
model WorkflowVersion {
  id         String   @id @default(cuid())
  version    Int
  definition Json
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([workflowId, version])
}

// ===================== Bucle de mejora supervisada (ADR 0004) =====================

/// Calificación y corrección humana de una respuesta del agente.
model MessageFeedback {
  id             String         @id @default(cuid())
  agentId        String
  agent          Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId    String
  conversationId String?
  userId         String?
  userMessage    String
  agentResponse  String
  rating         FeedbackRating
  comment        String?
  correction     String?
  status         ReviewStatus   @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@index([workspaceId, status, createdAt])
  @@index([agentId, createdAt])
}

/// Caso de prueba del agente (entrada, respuesta de referencia y rúbrica).
model EvalCase {
  id        String       @id @default(cuid())
  agentId   String
  agent     Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  input     String
  expected  String?
  criteria  String?
  tags      String[]     @default([])
  results   EvalResult[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([agentId])
}

model EvalRun {
  id              String             @id @default(cuid())
  agentId         String
  agent           Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId     String
  versionId       String?
  version         AgentVersion?      @relation(fields: [versionId], references: [id], onDelete: SetNull)
  status          EvalRunStatus      @default(QUEUED)
  judgeProviderId String
  judgeModel      String
  passThreshold   Float              @default(0.7)
  score           Float?
  passed          Int                @default(0)
  total           Int                @default(0)
  costUsd         Decimal            @default(0) @db.Decimal(18, 8)
  error           String?
  results         EvalResult[]
  suggestions     PromptSuggestion[]
  createdAt       DateTime           @default(now())
  finishedAt      DateTime?

  @@index([agentId, createdAt])
}

model EvalResult {
  id          String    @id @default(cuid())
  runId       String
  run         EvalRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  caseId      String?
  case        EvalCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  input       String
  expected    String?
  output      String?
  score       Float?
  passed      Boolean   @default(false)
  reasoning   String?
  needsReview Boolean   @default(false)
  humanScore  Float?
  humanNote   String?
  createdAt   DateTime  @default(now())

  @@index([runId])
}

/// Instantánea inmutable de la configuración de un agente.
model AgentVersion {
  id          String    @id @default(cuid())
  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json
  note        String?
  createdById String?
  evalRuns    EvalRun[]
  createdAt   DateTime  @default(now())

  @@unique([agentId, version])
}

/// Propuesta de mejora del prompt generada por IA; requiere aprobación humana.
model PromptSuggestion {
  id          String           @id @default(cuid())
  agentId     String
  agent       Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runId       String?
  run         EvalRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  status      SuggestionStatus @default(PENDING)
  rationale   String
  proposal    Json
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime         @default(now())

  @@index([agentId, createdAt])
}

// ===================== Catálogo, OAuth2 y Nexo Edge (ADR 0005) =====================

/// Tokens OAuth2 (authorization code) de un conector, cifrados con AES-256-GCM.
/// App OAuth de la plataforma por proveedor («Iniciar sesión con…» de las apps conectadas). La configura un
/// administrador de la plataforma desde la consola; el secreto va cifrado (contexto platform-oauth-app.client-secret).
/// Las variables OAUTH_<PROVEEDOR>_CLIENT_ID/SECRET quedan como respaldo si no hay fila.
model PlatformOAuthApp {
  provider           String   @id
  clientId           String
  clientSecretCipher String
  updatedById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model OAuthCredential {
  id                 String    @id @default(cuid())
  connectorId        String    @unique
  connector          Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  accessTokenCipher  String
  refreshTokenCipher String?
  expiresAt          DateTime?
  scope              String?
  accountLabel       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// Agente on-premise que conecta Nexo con bases de datos en redes privadas (conexión saliente WSS).
model EdgeAgent {
  id          String    @id @default(cuid())
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  lastSeenAt  DateTime?
  version     String?
  hostname    String?
  /// Claves de conexión que el Edge declara disponibles (sin credenciales).
  connections String[]  @default([])
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

// ===================== Nexo Copilot (ADR 0006) =====================

/// Conversación con el Copilot (agente propiedad de Nexo). El historial nativo del proveedor vive en `history`.
model CopilotSession {
  id          String            @id @default(cuid())
  workspaceId String
  userId      String
  agentId     String?
  mode        CopilotMode
  context     String?
  providerId  String
  model       String
  history     Json              @default("[]")
  messages    CopilotMessage[]
  proposals   CopilotProposal[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([workspaceId, createdAt])
  @@index([workspaceId, updatedAt])
}

/// Mensaje visible de la conversación (texto plano), calificable por el usuario.
model CopilotMessage {
  id        String           @id @default(cuid())
  sessionId String
  session   CopilotSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  text      String
  feedback  CopilotFeedback?
  createdAt DateTime         @default(now())

  @@index([sessionId, createdAt])
}

model CopilotProposal {
  id          String              @id @default(cuid())
  sessionId   String
  session     CopilotSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workspaceId String
  agentId     String?
  kind        CopilotProposalKind
  status      SuggestionStatus    @default(PENDING)
  summary     String
  payload     Json
  appliedById String?
  appliedAt   DateTime?
  createdAt   DateTime            @default(now())

  @@index([workspaceId, createdAt])
}

/// Calificación del usuario a una respuesta del Copilot (calidad gestionada por Nexo).
model CopilotFeedback {
  id                 String         @id @default(cuid())
  messageId          String         @unique
  message            CopilotMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  workspaceId        String
  userId             String
  rating             FeedbackRating
  comment            String?
  /// Solo si el usuario decidió compartir la conversación con Nexo.
  sharedConversation Json?
  createdAt          DateTime       @default(now())

  @@index([createdAt])
}

// ===================== Visibilidad y permisos de agentes (ADR 0007) =====================

model AgentShare {
  id            String          @id @default(cuid())
  agentId       String
  agent         Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  principalType SharePrincipal
  principalId   String
  permission    SharePermission @default(USE)
  createdAt     DateTime        @default(now())

  @@unique([agentId, principalType, principalId])
  @@index([principalType, principalId])
}

/// Grupo de usuarios transversal a las unidades (p. ej. "Gerentes de línea") al que se publican agentes (ADR 0007 D6).
model UserGroup {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     UserGroupMember[]

  @@unique([workspaceId, name])
}

model UserGroupMember {
  groupId   String
  group     UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

// ===================== Trabajo por resultados (ADR 0012 · E4) =====================
// Núcleo de la gestión obligatoria por resultados (RF07, RF08, RF29, RF30, RF31). Entidades aditivas y multi-tenant:
// toda consulta filtra por `workspaceId` (de `@CurrentAuth()`). Las referencias a `User`/`Agent`/`OrgUnit` son blandas
// (se validan en servicio y NO conceden acceso, igual que la estructura empresarial E1). La comunicación entre agentes,
// el handoff y los canales (E5: MensajeAgente, ContratoTransferencia, Canal, HiloCanal) son una cédula aparte.

/// Estado OPERATIVO de la tarea (ciclo del trabajo como DAG). Ortogonal al estado del resultado (RF08, solicitud §4).
enum EstadoTarea {
  PENDIENTE
  EN_EJECUCION
  ESPERANDO_APROBACION
  BLOQUEADA
  EN_REVISION
  COMPLETADA
  FALLIDA_CANCELADA
}

/// Estado del RESULTADO (verificable, RF29/RF31). COMPLETADA como DAG no implica ACEPTADO como resultado.
enum EstadoResultado {
  PROPUESTO
  COMPROMETIDO
  EN_PRODUCCION
  PENDIENTE_VALIDACION
  ACEPTADO
  DEVUELTO_INCUMPLIDO
}

/// Un producto intermedio (un correo redactado) no satisface un resultado de negocio (un recaudo confirmado), RF29.
enum TipoResultado {
  PRODUCTO_INTERMEDIO
  RESULTADO_NEGOCIO
}

/// Modo de verificación del resultado (RF30/ADR 0010 D4). ASISTIDA reutiliza la verificación cruzada, no la reimplementa.
enum ModoValidacion {
  DETERMINISTA
  HUMANA
  ASISTIDA
}

enum VeredictoValidacion {
  ACEPTA
  DEVUELVE
}

/// Objetivo (RF07): indicador, línea base, meta y plazo con dueño humano y responsable digital. Agrupa tareas.
/// Lo autoriza un humano (el sistema solo propone). Vínculo opcional a una unidad/empresa/línea por `orgUnitId`.
model Objetivo {
  id                 String    @id @default(cuid())
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Empresa / área / línea de negocio a la que pertenece (referencia blanda, validada en servicio).
  orgUnitId          String?
  codigo             String
  nombre             String
  indicador          String?
  lineaBase          String?
  meta               String?
  /// Fecha de negocio comprometida.
  plazo              DateTime?
  /// Dueño humano (referencia blanda a `User`; no concede acceso).
  duenoUserId        String?
  /// Responsable digital (referencia blanda a `Agent`).
  responsableAgentId String?
  /// Vigencia e historia (QA16): una reorganización no altera objetivos pasados.
  validFrom          DateTime  @default(now())
  validTo            DateTime?
  tareas             Tarea[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([workspaceId, codigo])
  @@index([workspaceId, orgUnitId])
}

/// Tarea (RF08): unidad de trabajo con criterio de aceptación, responsable (agente/equipo), dueño humano, prioridad,
/// fecha límite y estado operativo. Distingue producto intermedio de resultado de negocio. Lleva campos de delegación
/// (cadena `parentTareaId`, `profundidadDelegacion`, `correlationId`) para el control de ciclos de E5 (RF10).
model Tarea {
  id                    String             @id @default(cuid())
  workspaceId           String
  workspace             Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orgUnitId             String?
  objetivoId            String?
  objetivo              Objetivo?          @relation(fields: [objetivoId], references: [id], onDelete: SetNull)
  titulo                String
  descripcion           String?
  criterioAceptacion    String?
  entradas              Json               @default("{}")
  /// Responsable digital ejecutor (referencia blanda a `Agent`). El verificador debe ser distinto (RF30).
  responsableAgentId    String?
  equipoId              String?
  /// Dueño humano (referencia blanda a `User`).
  duenoUserId           String?
  prioridad             Int                @default(3)
  fechaLimite           DateTime?
  estado                EstadoTarea        @default(PENDIENTE)
  tipoResultado         TipoResultado      @default(PRODUCTO_INTERMEDIO)
  /// Delegación y control de ciclos (RF10; la validación dura llega con el handoff de E5).
  parentTareaId         String?
  profundidadDelegacion Int                @default(0)
  correlationId         String?
  validFrom             DateTime           @default(now())
  validTo               DateTime?
  contratoResultado     ContratoResultado?
  executions            Execution[]
  evidencias            Evidencia[]
  incumplimientos       Incumplimiento[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([workspaceId, estado])
  @@index([workspaceId, objetivoId])
  @@index([workspaceId, fechaLimite])
  @@index([parentTareaId])
}

/// Contrato de resultado (RF29): el resultado esperado como objeto verificable. Una descripción libre no lo reemplaza.
/// Un contrato COMPROMETIDO es inmutable: un cambio crea una versión nueva. La `reglaValidacion` es declarativa
/// (se evalúa con el motor de reglas puro del flujo, NUNCA con `eval`/`new Function`).
model ContratoResultado {
  id                 String                @id @default(cuid())
  workspaceId        String
  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tareaId            String?               @unique
  tarea              Tarea?                @relation(fields: [tareaId], references: [id], onDelete: SetNull)
  resultadoEsperado  String
  alcance            String?
  entradas           Json                  @default("{}")
  responsableAgentId String?
  duenoUserId        String?
  fecha              DateTime?
  presupuestoUsd     Decimal?              @db.Decimal(18, 8)
  indicador          String?
  /// Regla determinista declarativa: { combinator?: 'and'|'or', rules: [{ left, operator, right }] } (motor de flujos).
  reglaValidacion    Json                  @default("{}")
  /// Tipos/fuentes de evidencia obligatorios para aceptar.
  evidenciaExigida   Json                  @default("[]")
  tipoResultado      TipoResultado         @default(RESULTADO_NEGOCIO)
  nivelRiesgo        Int                   @default(1)
  estado             EstadoResultado       @default(PROPUESTO)
  version            Int                   @default(1)
  /// Tras comprometer queda inmutable (nueva versión para cambios).
  comprometidoAt     DateTime?
  validaciones       ValidacionResultado[]
  evidencias         Evidencia[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([workspaceId, estado])
}

/// Validación del resultado (RF30). Invariante de aplicación (garantizado en servicio): el verificador es distinto
/// del ejecutor. Una devolución conserva versión y motivo (código auditable, nunca el razonamiento del modelo).
model ValidacionResultado {
  id                  String              @id @default(cuid())
  workspaceId         String
  contratoResultadoId String
  contrato            ContratoResultado   @relation(fields: [contratoResultadoId], references: [id], onDelete: Cascade)
  modo                ModoValidacion
  /// Verificador: distinto del ejecutor (`Tarea.responsableAgentId`) y, si es humano, del dueño ejecutor.
  verificadorAgentId  String?
  validadorUserId     String?
  reglaAplicada       Json?
  veredicto           VeredictoValidacion
  motivo              String?
  evidenciaIds        String[]            @default([])
  /// Versión del contrato evaluada (la devolución conserva versión y motivo).
  version             Int                 @default(1)
  createdAt           DateTime            @default(now())

  @@index([workspaceId, contratoResultadoId])
}

/// Evidencia (prueba del resultado): REFERENCIA autorizada a la fuente (id externo, ejecución, enlace), no copia de
/// datos sensibles (RF35). Lleva propietario y vigencia. Puede colgar de la tarea o del contrato.
model Evidencia {
  id                  String             @id @default(cuid())
  workspaceId         String
  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contratoResultadoId String?
  contrato            ContratoResultado? @relation(fields: [contratoResultadoId], references: [id], onDelete: SetNull)
  tareaId             String?
  tarea               Tarea?             @relation(fields: [tareaId], references: [id], onDelete: SetNull)
  tipo                String
  descripcion         String?
  /// Referencia autorizada a la fuente: { connectorOpId?, externalId?, executionId?, url? }.
  referencia          Json               @default("{}")
  hash                String?
  /// Propietario de la evidencia (referencia blanda a `User`).
  propietarioUserId   String?
  /// Vigencia de la evidencia (null = sin límite).
  vigenteHasta        DateTime?
  createdAt           DateTime           @default(now())

  @@index([workspaceId, contratoResultadoId])
  @@index([workspaceId, tareaId])
}

/// Incumplimiento + plan de recuperación (RF31): alerta, responsable, plazo, y LÍMITES explícitos de reintentos,
/// gasto y ciclos, con escalamiento al siguiente nivel digital. Al agotar el límite se declara (nunca queda activo
/// indefinidamente ocultando un resultado no logrado). Lo detecta el cron de reconciliación existente.
model Incumplimiento {
  id                String    @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tareaId           String
  tarea             Tarea     @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  causa             String
  /// Responsable humano del plan (referencia blanda a `User`).
  responsableUserId String?
  /// Escalamiento al siguiente nivel digital (referencia blanda a `Agent`).
  escalaAgentId     String?
  planRecuperacion  String?
  plazo             DateTime?
  maxReintentos     Int       @default(0)
  maxCostoUsd       Decimal?  @db.Decimal(18, 8)
  maxCiclos         Int       @default(0)
  intentos          Int       @default(0)
  ciclos            Int       @default(0)
  /// `true` cuando el plan se resolvió (recuperado) o se declaró agotado el límite: el proceso deja de estar activo.
  resuelto          Boolean   @default(false)
  /// Cómo se cerró: null (abierto), `RECUPERADO`, `LIMITE_AGOTADO`, `PLAZO_VENCIDO`.
  resolucion        String?
  resueltoAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId, tareaId])
  @@index([workspaceId, resuelto])
}
