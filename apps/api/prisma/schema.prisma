// Nexo — modelo de datos
// Multi-tenant por Workspace: todo recurso de negocio pertenece a un workspace.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum ConnectorType {
  REST
  SOAP
  GRAPHQL
  MCP
  DATABASE
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum LlmKind {
  ANTHROPIC
  OPENAI_COMPATIBLE
  MOCK
}

enum ModelTier {
  PREMIUM
  STANDARD
  ECONOMY
}

enum BudgetPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum BudgetPolicy {
  BLOCK
  DOWNGRADE
  ALERT_ONLY
}

enum UsageSource {
  CHAT
  WORKFLOW
  MCP
  ROUTINE
  EVAL
  COPILOT
}

enum AgentVisibility {
  PRIVATE
  TEAM
  WORKSPACE
}

enum SharePrincipal {
  USER
  UNIT
  /// Grupo de usuarios del workspace (p. ej. "Gerentes de línea"), ADR 0007 D6.
  GROUP
}

enum SharePermission {
  USE
  EDIT
}

enum LaunchStatus {
  DRAFT
  LAUNCHED
}

enum CopilotMode {
  CREATE
  IMPROVE
  DIAGNOSE
}

enum CopilotProposalKind {
  CREATE_AGENT
  UPDATE_AGENT
}

enum FeedbackRating {
  UP
  DOWN
}

enum ReviewStatus {
  PENDING
  APPROVED
  DISCARDED
}

enum EvalRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum SuggestionStatus {
  PENDING
  APPLIED
  REJECTED
}

enum KnowledgeSourceType {
  TEXT
  URL
  FILE
}

enum DocumentStatus {
  READY
  FAILED
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum TriggerType {
  MANUAL
  WEBHOOK
  SCHEDULE
  AGENT
  MCP
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String
  passwordHash     String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  memberships      Membership[]
  groupMemberships UserGroupMember[]
}

model Workspace {
  id                  String          @id @default(cuid())
  name                String
  slug                String          @unique
  /// Permite que cualquier miembro cree agentes personales (ADR 0007).
  allowPersonalAgents Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  memberships         Membership[]
  connectors          Connector[]
  agents              Agent[]
  userGroups          UserGroup[]
  workflows           Workflow[]
  executions          Execution[]
  apiKeys             ApiKey[]
  secrets             Secret[]
  llmConnections      LlmConnection[]
  orgUnits            OrgUnit[]
  usage               UsageRecord[]
  skills              Skill[]
  knowledgeBases      KnowledgeBase[]
  agentRoutines       AgentRoutine[]
  edgeAgents          EdgeAgent[]
}

model Membership {
  id          String    @id @default(cuid())
  role        Role      @default(EDITOR)
  userId      String
  workspaceId String
  /// Unidad corporativa a la que se imputa el consumo del usuario (null = raíz).
  orgUnitId   String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orgUnit     OrgUnit?  @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@unique([userId, workspaceId])
}

/// Llaves de API para integraciones máquina-a-máquina (webhooks, servidor MCP).
model ApiKey {
  id          String    @id @default(cuid())
  name        String
  prefix      String
  hash        String    @unique
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
}

/// Credenciales cifradas (AES-256-GCM). Nunca se devuelven en claro por la API.
model Secret {
  id          String    @id @default(cuid())
  name        String
  ciphertext  String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, name])
}

/// Sistema externo: API REST, servicio SOAP, endpoint GraphQL o servidor MCP.
model Connector {
  id          String               @id @default(cuid())
  name        String
  description String?
  type        ConnectorType
  /// Configuración específica del tipo (baseUrl, wsdl, transporte MCP, headers...).
  config      Json                 @default("{}")
  /// Autenticación: { type: none|apiKey|bearer|basic|oauth2, ... } con referencias a secretos.
  auth        Json                 @default("{\"type\":\"none\"}")
  /// Integración del catálogo que originó el conector (ADR 0005), si aplica.
  catalogId   String?
  workspaceId String
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  operations  ConnectorOperation[]
  oauth       OAuthCredential?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([workspaceId])
}

/// Operación invocable de un conector. Cada operación se expone como "tool" para agentes.
model ConnectorOperation {
  id          String      @id @default(cuid())
  key         String
  name        String
  description String?
  /// JSON Schema de entrada.
  inputSchema Json        @default("{\"type\":\"object\",\"properties\":{}}")
  /// Definición: REST {method,path,query,headers,body}; SOAP {action,bodyTemplate}; GraphQL {query}; MCP {toolName}.
  definition  Json        @default("{}")
  connectorId String
  connector   Connector   @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  agentTools  AgentTool[]

  @@unique([connectorId, key])
}

model Agent {
  id                   String             @id @default(cuid())
  name                 String
  description          String?
  provider             String             @default("anthropic")
  model                String             @default("claude-opus-5-5")
  systemPrompt         String             @default("")
  /// low | medium | high | xhigh | max
  effort               String             @default("medium")
  maxTurns             Int                @default(12)
  /// Perfil estructurado: { role, goals[], responsibilities[], boundaries[], tone, outputFormat, language } (ADR 0003).
  profile              Json               @default("{}")
  /// Cadena de respaldo "<providerId>:<modelId>" (máx. 3).
  fallbackModels       String[]           @default([])
  /// Meta de calidad del bucle de mejora (0..1, ADR 0004).
  targetScore          Float              @default(0.85)
  /// Ciclo de vida de producción (ADR 0006): solo los agentes LAUNCHED se publican por MCP y ejecutan rutinas.
  launchStatus         LaunchStatus       @default(DRAFT)
  launchedAt           DateTime?
  launchOverrideReason String?
  /// Visibilidad y propiedad (ADR 0007).
  visibility           AgentVisibility    @default(PRIVATE)
  ownerId              String?
  shares               AgentShare[]
  /// Centro de costo cuando el agente corre sin usuario (flujos, webhooks, MCP).
  costCenterId         String?
  costCenter           OrgUnit?           @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  workspaceId          String
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tools                AgentTool[]
  conversations        Conversation[]
  skills               AgentSkill[]
  knowledge            AgentKnowledge[]
  examples             AgentExample[]
  routines             AgentRoutine[]
  feedback             MessageFeedback[]
  evalCases            EvalCase[]
  evalRuns             EvalRun[]
  versions             AgentVersion[]
  suggestions          PromptSuggestion[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([workspaceId])
}

model AgentTool {
  id               String             @id @default(cuid())
  agentId          String
  operationId      String
  /// Si es true, la llamada requiere aprobación humana (human-in-the-loop).
  requiresApproval Boolean            @default(false)
  agent            Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  operation        ConnectorOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([agentId, operationId])
}

model Conversation {
  id        String   @id @default(cuid())
  title     String   @default("Nueva conversación")
  /// Usuario dueño de la conversación (ADR 0007: las conversaciones son privadas).
  userId    String?
  /// Proveedor que produjo el historial (los formatos no son intercambiables).
  provider  String   @default("anthropic")
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Historial completo en formato del proveedor (append-only).
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId, userId])
}

/// Flujo de automatización como grafo dirigido (nodos + aristas).
model Workflow {
  id              String            @id @default(cuid())
  name            String
  description     String?
  active          Boolean           @default(false)
  /// { nodes: WorkflowNode[], edges: WorkflowEdge[] }
  definition      Json              @default("{\"nodes\":[],\"edges\":[]}")
  /// Cron para disparador programado (opcional).
  schedule        String?
  /// Token público para disparo vía webhook.
  webhookToken    String            @unique @default(cuid())
  version         Int               @default(1)
  /// Flujo que se dispara cuando una ejecución de este flujo falla (práctica n8n).
  errorWorkflowId String?
  workspaceId     String
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions      Execution[]
  versions        WorkflowVersion[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([workspaceId])
}

model Execution {
  id          String          @id @default(cuid())
  status      ExecutionStatus @default(QUEUED)
  trigger     TriggerType     @default(MANUAL)
  input       Json            @default("{}")
  output      Json?
  error       String?
  /// Bitácora por nodo: [{ nodeId, status, startedAt, finishedAt, input, output, error }]
  steps       Json            @default("[]")
  workflowId  String
  workflow    Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime        @default(now())

  @@index([workspaceId, createdAt])
  @@index([workflowId])
}

// ===================== Gobierno de IA (ADR 0002) =====================

/// Conexión a un proveedor LLM configurada por el administrador.
model LlmConnection {
  id           String     @id @default(cuid())
  name         String
  kind         LlmKind
  baseUrl      String?
  /// API key cifrada con AES-256-GCM.
  apiKeyCipher String?
  enabled      Boolean    @default(true)
  workspaceId  String
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  models       LlmModel[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([workspaceId])
}

/// Modelo habilitado en una conexión, con su tarifa (USD por millón de tokens).
model LlmModel {
  id                  String        @id @default(cuid())
  modelId             String
  label               String
  tier                ModelTier     @default(STANDARD)
  inputUsdPerMTok     Decimal       @db.Decimal(12, 6)
  outputUsdPerMTok    Decimal       @db.Decimal(12, 6)
  cacheReadUsdPerMTok Decimal?      @db.Decimal(12, 6)
  enabled             Boolean       @default(true)
  connectionId        String
  connection          LlmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([connectionId, modelId])
}

/// Unidad corporativa (árbol). La raíz (parentId = null) es el tope global del workspace.
model OrgUnit {
  id            String         @id @default(cuid())
  name          String
  code          String?
  /// Modelos permitidos "<providerId>:<modelId>". Vacío = hereda del padre.
  allowedModels String[]       @default([])
  parentId      String?
  parent        OrgUnit?       @relation("OrgTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      OrgUnit[]      @relation("OrgTree")
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships   Membership[]
  agents        Agent[]
  budget        Budget?
  ledger        BudgetLedger[]
  alerts        BudgetAlert[]
  usage         UsageRecord[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([workspaceId])
}

/// Bolsa de presupuesto de una unidad (descuenta también el consumo de sus descendientes).
model Budget {
  id                  String       @id @default(cuid())
  orgUnitId           String       @unique
  orgUnit             OrgUnit      @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  period              BudgetPeriod @default(MONTHLY)
  limitUsd            Decimal      @db.Decimal(18, 8)
  policy              BudgetPolicy @default(BLOCK)
  alertThresholds     Int[]        @default([50, 80, 100])
  downgradeProviderId String?
  downgradeModel      String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

/// Gasto acumulado por unidad y periodo (incluye descendientes). Incrementos atómicos.
model BudgetLedger {
  orgUnitId String
  orgUnit   OrgUnit  @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  periodKey String
  spentUsd  Decimal  @default(0) @db.Decimal(18, 8)
  updatedAt DateTime @updatedAt

  @@id([orgUnitId, periodKey])
}

model BudgetAlert {
  id        String   @id @default(cuid())
  orgUnitId String
  orgUnit   OrgUnit  @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  periodKey String
  threshold Int
  spentUsd  Decimal  @db.Decimal(18, 8)
  limitUsd  Decimal  @db.Decimal(18, 8)
  createdAt DateTime @default(now())

  @@unique([orgUnitId, periodKey, threshold])
}

/// Registro de consumo por llamada al modelo. No guarda contenido de prompts ni respuestas.
model UsageRecord {
  id               String      @id @default(cuid())
  workspaceId      String
  workspace        Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orgUnitId        String?
  orgUnit          OrgUnit?    @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  userId           String?
  agentId          String?
  workflowId       String?
  executionId      String?
  conversationId   String?
  source           UsageSource
  providerId       String
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int         @default(0)
  cacheWriteTokens Int         @default(0)
  costUsd          Decimal     @db.Decimal(18, 8)
  createdAt        DateTime    @default(now())

  @@index([workspaceId, createdAt])
  @@index([orgUnitId, createdAt])
}

// ===================== Estudio de agentes y n8n (ADR 0003) =====================

/// Habilidad reutilizable: instrucciones + operaciones, cargada bajo demanda por el agente (load_skill).
model Skill {
  id           String       @id @default(cuid())
  name         String
  slug         String
  description  String
  instructions String
  /// Operaciones de conector que la skill aporta como herramientas.
  operationIds String[]     @default([])
  workspaceId  String
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agents       AgentSkill[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([workspaceId, slug])
}

model AgentSkill {
  agentId String
  skillId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([agentId, skillId])
}

model KnowledgeBase {
  id          String              @id @default(cuid())
  name        String
  description String?
  workspaceId String
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents   KnowledgeDocument[]
  chunks      KnowledgeChunk[]
  agents      AgentKnowledge[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([workspaceId])
}

model AgentKnowledge {
  agentId         String
  knowledgeBaseId String
  agent           Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@id([agentId, knowledgeBaseId])
}

model KnowledgeDocument {
  id              String              @id @default(cuid())
  title           String
  sourceType      KnowledgeSourceType
  source          String?
  status          DocumentStatus      @default(READY)
  error           String?
  charCount       Int                 @default(0)
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase       @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks          KnowledgeChunk[]
  createdAt       DateTime            @default(now())

  @@index([knowledgeBaseId])
}

/// Fragmento indexado con búsqueda full-text de PostgreSQL (columna tsvector generada en la migración).
model KnowledgeChunk {
  id              String                   @id @default(cuid())
  ordinal         Int
  content         String
  search          Unsupported("tsvector")?
  documentId      String
  document        KnowledgeDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase            @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId])
}

/// Ejemplo de entrenamiento few-shot (entrada → salida esperada).
model AgentExample {
  id        String   @id @default(cuid())
  input     String
  output    String
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// Tarea recurrente de un agente (cron + instrucción).
model AgentRoutine {
  id               String       @id @default(cuid())
  name             String
  prompt           String
  schedule         String
  timezone         String       @default("UTC")
  enabled          Boolean      @default(true)
  notifyWebhookUrl String?
  lastRunAt        DateTime?
  lastStatus       RunStatus?
  agentId          String
  agent            Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId      String
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs             RoutineRun[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([workspaceId])
}

model RoutineRun {
  id         String       @id @default(cuid())
  status     RunStatus    @default(RUNNING)
  output     String?
  error      String?
  costUsd    Decimal      @default(0) @db.Decimal(18, 8)
  routineId  String
  routine    AgentRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  startedAt  DateTime     @default(now())
  finishedAt DateTime?

  @@index([routineId, startedAt])
}

/// Versión anterior de la definición de un flujo (historial inmutable).
model WorkflowVersion {
  id         String   @id @default(cuid())
  version    Int
  definition Json
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([workflowId, version])
}

// ===================== Bucle de mejora supervisada (ADR 0004) =====================

/// Calificación y corrección humana de una respuesta del agente.
model MessageFeedback {
  id             String         @id @default(cuid())
  agentId        String
  agent          Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId    String
  conversationId String?
  userId         String?
  userMessage    String
  agentResponse  String
  rating         FeedbackRating
  comment        String?
  correction     String?
  status         ReviewStatus   @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@index([workspaceId, status, createdAt])
  @@index([agentId, createdAt])
}

/// Caso de prueba del agente (entrada, respuesta de referencia y rúbrica).
model EvalCase {
  id        String       @id @default(cuid())
  agentId   String
  agent     Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  input     String
  expected  String?
  criteria  String?
  tags      String[]     @default([])
  results   EvalResult[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([agentId])
}

model EvalRun {
  id              String             @id @default(cuid())
  agentId         String
  agent           Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId     String
  versionId       String?
  version         AgentVersion?      @relation(fields: [versionId], references: [id], onDelete: SetNull)
  status          EvalRunStatus      @default(QUEUED)
  judgeProviderId String
  judgeModel      String
  passThreshold   Float              @default(0.7)
  score           Float?
  passed          Int                @default(0)
  total           Int                @default(0)
  costUsd         Decimal            @default(0) @db.Decimal(18, 8)
  error           String?
  results         EvalResult[]
  suggestions     PromptSuggestion[]
  createdAt       DateTime           @default(now())
  finishedAt      DateTime?

  @@index([agentId, createdAt])
}

model EvalResult {
  id          String    @id @default(cuid())
  runId       String
  run         EvalRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  caseId      String?
  case        EvalCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  input       String
  expected    String?
  output      String?
  score       Float?
  passed      Boolean   @default(false)
  reasoning   String?
  needsReview Boolean   @default(false)
  humanScore  Float?
  humanNote   String?
  createdAt   DateTime  @default(now())

  @@index([runId])
}

/// Instantánea inmutable de la configuración de un agente.
model AgentVersion {
  id          String    @id @default(cuid())
  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json
  note        String?
  createdById String?
  evalRuns    EvalRun[]
  createdAt   DateTime  @default(now())

  @@unique([agentId, version])
}

/// Propuesta de mejora del prompt generada por IA; requiere aprobación humana.
model PromptSuggestion {
  id          String           @id @default(cuid())
  agentId     String
  agent       Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runId       String?
  run         EvalRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  status      SuggestionStatus @default(PENDING)
  rationale   String
  proposal    Json
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime         @default(now())

  @@index([agentId, createdAt])
}

// ===================== Catálogo, OAuth2 y Nexo Edge (ADR 0005) =====================

/// Tokens OAuth2 (authorization code) de un conector, cifrados con AES-256-GCM.
model OAuthCredential {
  id                 String    @id @default(cuid())
  connectorId        String    @unique
  connector          Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  accessTokenCipher  String
  refreshTokenCipher String?
  expiresAt          DateTime?
  scope              String?
  accountLabel       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// Agente on-premise que conecta Nexo con bases de datos en redes privadas (conexión saliente WSS).
model EdgeAgent {
  id          String    @id @default(cuid())
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  lastSeenAt  DateTime?
  version     String?
  hostname    String?
  /// Claves de conexión que el Edge declara disponibles (sin credenciales).
  connections String[]  @default([])
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

// ===================== Nexo Copilot (ADR 0006) =====================

/// Conversación con el Copilot (agente propiedad de Nexo). El historial nativo del proveedor vive en `history`.
model CopilotSession {
  id          String            @id @default(cuid())
  workspaceId String
  userId      String
  agentId     String?
  mode        CopilotMode
  context     String?
  providerId  String
  model       String
  history     Json              @default("[]")
  messages    CopilotMessage[]
  proposals   CopilotProposal[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([workspaceId, createdAt])
}

/// Mensaje visible de la conversación (texto plano), calificable por el usuario.
model CopilotMessage {
  id        String           @id @default(cuid())
  sessionId String
  session   CopilotSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  text      String
  feedback  CopilotFeedback?
  createdAt DateTime         @default(now())

  @@index([sessionId, createdAt])
}

model CopilotProposal {
  id          String              @id @default(cuid())
  sessionId   String
  session     CopilotSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workspaceId String
  agentId     String?
  kind        CopilotProposalKind
  status      SuggestionStatus    @default(PENDING)
  summary     String
  payload     Json
  appliedById String?
  appliedAt   DateTime?
  createdAt   DateTime            @default(now())

  @@index([workspaceId, createdAt])
}

/// Calificación del usuario a una respuesta del Copilot (calidad gestionada por Nexo).
model CopilotFeedback {
  id                 String         @id @default(cuid())
  messageId          String         @unique
  message            CopilotMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  workspaceId        String
  userId             String
  rating             FeedbackRating
  comment            String?
  /// Solo si el usuario decidió compartir la conversación con Nexo.
  sharedConversation Json?
  createdAt          DateTime       @default(now())

  @@index([createdAt])
}

// ===================== Visibilidad y permisos de agentes (ADR 0007) =====================

model AgentShare {
  id            String          @id @default(cuid())
  agentId       String
  agent         Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  principalType SharePrincipal
  principalId   String
  permission    SharePermission @default(USE)
  createdAt     DateTime        @default(now())

  @@unique([agentId, principalType, principalId])
  @@index([principalType, principalId])
}

/// Grupo de usuarios transversal a las unidades (p. ej. "Gerentes de línea") al que se publican agentes (ADR 0007 D6).
model UserGroup {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     UserGroupMember[]

  @@unique([workspaceId, name])
}

model UserGroupMember {
  groupId   String
  group     UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([groupId, userId])
  @@index([userId])
}
