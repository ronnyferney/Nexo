{
  "name": "nexo",
  "version": "1.0.0",
  "private": true,
  "description": "Nexo — plataforma de agentes de IA con conectores REST, SOAP, GraphQL y MCP, y flujos de automatización",
  "scripts": {
    "install:all": "npm --prefix apps/api install && npm --prefix apps/web install",
    "dev:api": "npm --prefix apps/api run start:dev",
    "dev:web": "npm --prefix apps/web start",
    "db:migrate": "npm --prefix apps/api run prisma:migrate",
    "build": "npm --prefix apps/api run build && npm --prefix apps/web run build",
    "test": "npm --prefix apps/api test",
    "lint": "npm --prefix apps/api run lint",
    "infra:up": "docker compose up -d postgres redis",
    "up": "docker compose up -d --build",
    "local": "bash scripts/dev-local.sh up",
    "local:stop": "bash scripts/dev-local.sh stop",
    "local:status": "bash scripts/dev-local.sh status",
    "local:logs": "bash scripts/dev-local.sh logs",
    "local:demo": "node scripts/demo-local.mjs",
    "local:rpa": "npm --prefix tools/rpa install --no-audit --no-fund --silent && node tools/rpa/nexo-rpa.mjs",
    "release": "node scripts/release.mjs prepare",
    "release:dry": "node scripts/release.mjs prepare --dry-run",
    "test:release": "node --test scripts/release.test.mjs"
  },
  "engines": { "node": ">=22" }
}
